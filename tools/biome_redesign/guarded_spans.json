  {
    "path": "src/game/world/east/npcs.inc",
    "before": "The Brook sings a different song at night.",
    "after": "At dusk we tune our fiddles to the mill wheel. The low note is the Brook running beneath it."
  },
  {
    "path": "src/game/world/west/npcs.inc",
    "before": "The DUSK kin drink starlight on this fen.",
    "after": "We cut reeds at low water, soak them overnight, and weave the walk boards at first light."
  },
  {
    "path": "src/game/world/west/npcs.inc",
    "before": "The Hall Master MAREN was a fisher's girl. Now look at her. Still smells of the sea, though.",
    "after": "Our nets dry beside the quay every morning. Maren still mends one when the Hall goes quiet."
  },
  {
    "path": "src/game/world/west/npcs.inc",
    "before": "Salted, dried, sold in Brine. That's island life. Could do with more SALT, mind.",
    "after": "We plant beans in the shell grit behind Oda's house, then trade the catch for salt in Brine."
  },
  {
    "path": "src/game/world/north/npcs.inc",
    "before": "On a clear winter night the aurora shines over the flume.",
    "after": "The sawmill flume freezes at dawn. We break its skin so the wheel can turn before the loggers return."
  },
  {
    "path": "src/game/world/north/npcs.inc",
    "before": "Frosthollow keeps its hearths lit all winter. And winter here is most of the year.",
    "after": "Snow on the roofs, steam from the spring: we warm our hands there before setting the hearths."
  },
  {
    "path": "src/game/world/far/npcs.inc",
    "before": "Ore carts turn at that table. I counted thirty-two wheels today!",
    "after": "The rail yard has two shifts: iron carts by day and lantern repairs after dark."
  },
  {
    "path": "src/game/world/far/npcs.inc",
    "before": "My hammer arm's retired. My ears aren't. The volcano's snoring nicely today.",
    "after": "Our forge runs on cooled Caldera stone. I can hear when the ore is ready just by the ring."
  },
  {
    "path": "src/game/world/far/npcs.inc",
    "before": "Moonflowers only open for people who aren't looking for them. You weren't, were you?",
    "after": "We hang paper lanterns along the tower steps; the night garden opens when the moonflowers do."
  },
  {
    "path": "src/game/world/grim/npcs.inc",
    "before": "I light every lantern in DUSKMERE at dusk and again at noon. The ash makes noon look like dusk.",
    "after": "We light the memorial lanterns twice: once for the living at noon, once for the lost at dusk."
  },
