[LORE_GLASS_DUNES] = { LCH_PLACES, LSRC_GLASS_DUNES, "GLASS DUNES",
    "Two fires live beneath the land: CALDERON's forge and the old fire OSSUREX remembers. "
    "The lava cooled to obsidian glass while ash wandered toward the March.",
    "These dunes were once a river of fire. Now the glass sings in the wind." },
[LORE_STAR_CAIRN] = { LCH_PLACES, LSRC_STAR_CAIRN, "STAR CAIRN",
    "Stargazers marked the northern sky with stones above the clouds. "
    "On some nights an aurora traces the old chart in green light.",
    "Our cairn marks the sky even when snow hides every trail." },
[LORE_GREYWATER] = { LCH_PLACES, LSRC_GREYWATER, "GREYWATER FJORD",
    "An old village lies beneath the fjord. Fisherfolk say NOCTHALE still sings near the Drowned Bell. "
    "Its song is a warning, not a wild kin encounter.",
    "If you hear a song under the grey water, turn your boat toward home." },
