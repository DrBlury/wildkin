    PERSON(MAP_ANVIL_HALL, 7, 20, GUIDE, DOWN, LOOK, TALK, LSRC_FAR_HALL_GUIDE, "HALL GUIDE",
           "Push the pumice boulders onto the plates. Stuck? Step outside and they're reset."),
