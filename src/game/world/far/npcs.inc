    WARDEN(MAP_EMBER_TUNNEL, 20, 15, WARDEN_A, LEFT, 3, TR_ET_ASHA, NO_KIN, "Hear that? The Caldera hums. It's asleep."),
    /* moonveil path */
    PERSON(MAP_MOONVEIL, 29, 30, VILLAGER, DOWN, WANDER, SLEEPER, NO_LORE, "SLEEPWALKER", 0),
