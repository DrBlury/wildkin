               "The EMBER TUNNEL's up there. Past the lava, the last passage is blocked by boulders."),
    PERSON(MAP_CINDERMOOR, 6, 22, KID, DOWN, WANDER, TALK, NO_LORE, "KID",
           "When I grow up I'm going to be a smith. Or a SALAMBER. Whichever's hotter."),
    PERSON_KIN(MAP_CINDERMOOR, 19, 15, KID_B, RIGHT, WANDER, TALK, NO_LORE, SP_SALAMBER, "KID",
               "My SALAMBER sleeps in the bread oven. Mum pretends not to know."),
    PERSON(MAP_CINDERMOOR, 8, 1, ELDER, DOWN, STILL, TALK, NO_LORE, "OLD SOAKER",
           "Found the gap in the crags, did you? Every smith in town knows it. None of them admit it."),
    PERSON(MAP_CINDER_HEARTH, 5, 2, HEALER, DOWN, STILL, CINDER_TENDER, LSRC_TENDER, "TENDER COLE", 0),
