/* world/far/npcs.inc -- People: PERSON(...), PERSON_KIN(...), WARDEN(...),. Owner: W-FAR. */
    /* cinder road */
    PERSON_KIN(MAP_CINDER_ROAD, 5, 19, VILLAGER, RIGHT, LOOK, TALK, NO_LORE, SP_RIVETILLO, "HIKER",
               "CINDERMOOR is straight on east. Keep to the gravel: the ash either side is hot a hand's width down."),
    PERSON(MAP_CINDER_ROAD, 28, 29, FISHER, LEFT, LOOK, TALK, LSRC_PROSPECTOR, "PROSPECTOR",
           "The old rails still hold. The ore's mostly gone, but you find a lump now and then."),
    WARDEN(MAP_CINDER_ROAD, 18, 5, WARDEN_A, DOWN, 2, TR_CR_OSKAR, SP_RIVETILLO, "Ash in my boots again. Worth it."),
    WARDEN(MAP_CINDER_ROAD, 34, 14, WARDEN_B, LEFT, 2, TR_CR_MINA, SP_MAGNITICK,
           "MAGNITICK stuck to the rails again. Iron is iron."),
    WARDEN(MAP_CINDER_ROAD, 24, 26, WARDEN_A, UP, 3, TR_CR_BRAND, NO_KIN, "The brush grows back greener after every bout."),
    /* cindermoor */
    PERSON(MAP_CINDERMOOR, 18, 17, ELDER, LEFT, STILL, FOUNDER, NO_LORE, "FOUNDER HALVARD", 0),
    PERSON(MAP_CINDERMOOR, 32, 17, GRAN, DOWN, LOOK, TALK, LSRC_CINDER_ELDER, "OLD SMITH ENID",
           "My hammer arm's retired. My ears aren't. The volcano's snoring nicely today."),
    PERSON(MAP_CINDERMOOR, 36, 8, GUIDE, DOWN, LOOK, TALK, LSRC_FAR_HALL_GUIDE, "HALL CRIER",
           "The ANVIL HALL is open to every warden. Mind the gates!"),
