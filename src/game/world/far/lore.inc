/* world/far/lore.inc -- Lorebook entries: [LORE_X] = { LCH_..., LSRC_..., "TITLE", "page", "talk" },. Owner: W-FAR. */

    [LORE_CINDERMOOR] = { LCH_PLACES, LSRC_CINDER_ELDER, "CINDERMOOR",
        "Cindermoor is a smithing town built on the cooled lava of the old volcano east of Lumen City. "
        "Its streets are paved with basalt setts, its roofs are iron and rust, and there is always a "
        "chimney smoking somewhere.\n\n"
        "The town grew up around heat. The ground stays warm all year, hot springs bubble up between "
        "the houses, and the forge pool south of the plaza never cools. Smiths came for the heat and "
        "stayed for the kin: SALAMBER sun themselves on the warm stones, RIVETILLO roll through the "
        "streets, and MAGNITICK cling to every railing.\n\n"
        "In the plaza hangs the great bell. It rings when the volcano rumbles, so everyone knows to "
        "check on CALDERON's kin in the EMBER TUNNEL.\n\n"
        "REAL SCIENCE: volcanic ground stays warm for centuries, and hot springs are rainwater heated "
        "deep underground.\n\nVALE ONLY: the town's kin keep the volcano's surplus spilling gently.",
        "Sit, sit. The stones are warm. They always are, here.\f"
        "Let me tell you how a town ends up on top of a volcano." },

    [LORE_CALDERON] = { LCH_LEGENDS, LSRC_CINDER_ELDER, "CALDERON",
        "Under the volcano, in a chamber the smiths call the CALDERA HEART, sleeps CALDERON: a forge "
        "salamander as long as a street, with scales like ingots and a belly full of molten iron.\n\n"
        "The first smiths did not build the forge. They found it. CALDERON's warmth had kept a pool "
        "of lava liquid for a thousand years, and iron ore sweated out of the rock around it. People "
        "only had to learn to take a little, and to leave the rest.\n\n"
        "Every smith of Cindermoor takes the same vow: never to wake CALDERON for gain. The volcano "
        "sleeps as long as the legend is content. Only a warden may go to the Caldera Heart, and only "
        "to answer it, never to wake it.\n\n"
        "The way lies through the EMBER TUNNEL, past boulders only a strong kin can move.",
        "My grandmother saw it once. Just the tail, sliding under the lava.\f"
        "She said it was warm like a hearth, not like a fire. There's a difference." },

    [LORE_CINDER_ROAD] = { LCH_PLACES, LSRC_PROSPECTOR, "CINDER ROAD",
        "CINDER ROAD runs east from Lumen City to Cindermoor across a field of old lava. The road is "
        "raked cinder gravel. Either side is soft volcanic ash, patches of hardy ember brush, and in "
        "the middle a lava lake that has never quite cooled.\n\n"
        "Fumaroles hiss steam that smells of rotten eggs: that is sulfur, and it leaves yellow crusts "
        "on the stones. Old mine rails in the south once carried ore to Cindermoor.\n\n"
        "Wild kin love the warm ground. SALAMBER and CINDERUB bask, STINGLET hide under the stones, "
        "and RIVETILLO pick up iron grit for their shells.\n\n"
        "REAL SCIENCE: fumaroles are vents where volcanic gas escapes, and the smell is hydrogen "
        "sulfide.",
        "Careful where you step, youngster. That ash is hot a hand's width down.\f"
        "I've prospected this road forty years. Here's what I know." },

    [LORE_BASALT_GLASS] = { LCH_BIOLOGY, LSRC_PROSPECTOR, "BASALT AND GLASS",
        "When lava cools slowly, its minerals have time to grow into crystals, and it becomes basalt. "
        "As it shrinks, it cracks into columns, most of them six-sided, like the cliffs around "
        "Cindermoor.\n\n"
        "When lava cools in an instant, in water or thin air, there is no time for crystals at all. "
        "It freezes as a glass: obsidian, black and sharp. Froth of gas trapped in cooling lava makes "
        "pumice, a rock so full of bubbles it floats.\n\n"
        "Volcanic kin grow shells from all three. A SALAMBER's scales are glassy, a RIVETILLO's "
        "plates are basalt, and the Anvil Hall's training boulders are pumice.\n\n"
        "REAL SCIENCE: columnar basalt, obsidian and pumice are all real, and pumice really floats.\n\n"
        "VALE ONLY: kin kernels can pump from the heat stored in cooling rock.",
        "See this? Black glass. Lava that cooled too fast to make crystals.\f"
        "And this one floats! Let me show you why." },

    [LORE_TYPE_METAL] = { LCH_TYPES, LSRC_APPRENTICE, "METAL KIN",
        "METAL kin have kernels of magnetite, the same magnetic iron oxide some real bacteria grow to "
        "find their way. They pump from magnetic fields and the tiny currents a moving magnet makes, "
        "and they grow iron armour.\n\n"
        "That armour shrugs off most blows, poison cannot touch it, and a strong field bends the "
        "cosmic rays that feed ASTRAL kin. But heat forges iron and water rusts it: BLAZE and TIDE "
        "moves strike a METAL kin's weak spot, and so do BRAWL blows that dent it.\n\n"
        "MAGNITICK, LODEHORN, RIVETILLO and FOUNDRAKE all live around Cindermoor, where the ore is.\n\n"
        "REAL SCIENCE: magnetotactic bacteria really grow chains of magnetite crystals.\n\n"
        "VALE ONLY: a kin kernel made of them.",
        "Master BRONWEN says you can't forge a thing you don't understand.\f"
        "So I study the METAL kin. Want to hear?" },

    [LORE_FORGING] = { LCH_CRAFTING, LSRC_APPRENTICE, "FORGING",
        "A smith heats iron until it glows, then shapes it with hammer blows on an anvil. Every blow "
        "must land at the right moment: too early and the metal is too hot and soft, too late and it "
        "has cooled and cracks.\n\n"
        "The forge in Cindermoor makes lantern frames, tools and sprinklers. Wardens bring iron ore and "
        "coal, and the smith helps them strike on the beat.\n\n"
        "A BLAZE kin sleeping in the furnace keeps it at a steady white heat, better than any bellows.\n\n"
        "REAL SCIENCE: glowing iron changes colour with temperature, and smiths judge heat by eye.",
        "Hammer on the beat! That's the whole secret. Well, most of it.\f"
        "Here, let me show you how the forge works." },

    [LORE_ANVIL_HALL] = { LCH_HALLS, LSRC_FAR_HALL_GUIDE, "THE ANVIL HALL",
        "The ANVIL HALL of Cindermoor trains wardens of METAL and BLAZE kin. Its Master, BRONWEN, "
        "was a smith before she was a warden.\n\n"
        "The Hall is three chambers stacked behind iron gates. Each gate rises when every pressure "
        "plate of its chamber is weighed down. The boulders are pumice: foam-light volcanic rock, so "
        "anyone can push them. Push them onto the plates, but think first: a boulder pushed into a "
        "corner stays there. If you get stuck, step outside and the boulders are reset.\n\n"
        "Beat Master BRONWEN for the ANVIL CREST. With it, a strong kin in your team can push real "
        "boulders out in the world.",
        "Welcome to the ANVIL HALL! First time?\f"
        "Then listen: the gates, the plates, and the boulders that float." },

    [LORE_EMBER_TUNNEL] = { LCH_PLACES, LSRC_FAR_MINER, "THE EMBER TUNNEL",
        "The EMBER TUNNEL is an old lava tube north of Cindermoor: a cave that formed when the outside "
        "of a lava river cooled into a crust while the inside kept flowing and drained away.\n\n"
        "Miners dug side passages for iron ore, and laid rails for their carts. Lava still seeps "
        "through in places, and ember moss grows in the warm corners, where wild kin shelter.\n\n"
        "The far end opens into the CALDERA HEART, but the last passage is blocked by boulders "
        "that only a strong kin can move, with the ANVIL CREST.\n\n"
        "REAL SCIENCE: lava tubes are real caves, some many kilometres long.",
        "Keep your lantern lit in there. It's dark, and the rails are loose.\f"
        "I'll tell you how that tunnel got there. It's a good story." },

    [LORE_MOONVEIL] = { LCH_PLACES, LSRC_FAR_STARGAZER, "MOONVEIL PATH",
        "MOONVEIL PATH climbs north from Lumen City to Dreamspire through meadows of mint moon grass "
        "and pink moonpetals, with blossom trees along the way and a still pond that holds the stars.\n\n"
        "The air is quiet here. Travellers say they dream more vividly after walking it, and that the "
        "kin are sleepier: DOZLOTH nap in the branches, MANDRAGOR hum lullabies from the flowerbeds, "
        "and at night LUMOTH drift over the petals.\n\n"
        "On very clear nights, a QILUMEN is said to cross the meadows, its mane full of starlight.",
        "Look up. Clear as glass tonight, isn't it?\f"
        "This path is the best place in the Vale to watch the sky. Let me tell you about it." },

    [LORE_DREAMSPIRE] = { LCH_PLACES, LSRC_DREAMREADER, "DREAMSPIRE",
        "Dreamspire is a town of stacked towers, paper lanterns and blossom trees on the hills north "
        "of Lumen. Its people keep late hours and short mornings, and they take their dreams very "
        "seriously.\n\n"
        "The MIRROR HALL trains DREAM kin, and the DUST LIBRARY, older than the town, keeps every "
        "book the Vale ever wrote about sleep.\n\n"
        "Dreamers leave their bad dreams at the statue of the SLUMBAKU in the plaza. They say the "
        "real SLUMBAKU wander in at night to eat them.",
        "Ah, a visitor. You look like someone with interesting dreams.\f"
        "Let me tell you about our town while you're awake." },

    [LORE_DREAM_FIELDS] = { LCH_BIOLOGY, LSRC_DREAMREADER, "HOW DREAM KIN PUMP",
        "Every living brain gives off faint electric fields as its nerve cells fire. The fields are "
        "strongest and slowest in deep sleep, when huge numbers of cells fire together in waves.\n\n"
        "DREAM kin pump from those fields. That is why they love sleepers, why a town full of dreamers "
        "is full of DREAM kin, and why a DREAM kin can make a foe drowsy: it drinks the rhythm of an "
        "awake mind and gives back the slow waves of sleep.\n\n"
        "REAL SCIENCE: brain waves are real, and deep sleep has slow, strong waves.\n\n"
        "VALE ONLY: kernels tuned to them.",
        "Do you know why DREAM kin follow sleepers about?\f"
        "It's not magic. Well. It's not ONLY magic." },

    [LORE_MIRROR_HALL] = { LCH_HALLS, LSRC_MIRROR_GUIDE, "THE MIRROR HALL",
        "The MIRROR HALL of Dreamspire trains wardens of DREAM kin. Its Master, VESPER, is said to "
        "know a warden's next move before they do.\n\n"
        "The Hall is four mirrored rooms and no doors between them. Star-marked teleport pads link "
        "them in pairs: step on one and you appear on its twin. Some pads lead onward, some lead back "
        "to the start. Remember which is which.\n\n"
        "Beat Master VESPER for the DREAM CREST. With it, a TELEPORT kin can take you back to the last "
        "Hearth Hall you rested at.",
        "The Hall has no doors inside. Only mirrors.\f"
        "Let me explain before you get lost. Everyone gets lost." },

    [LORE_DUST_LIBRARY] = { LCH_PLACES, LSRC_LIBRARIAN, "THE DUST LIBRARY",
        "The DUST LIBRARY stands at the east end of Dreamspire. Nobody knows who founded it; the "
        "town grew up around it. Its shelves hold every book the Vale has written about sleep, "
        "dreams and kin, and a great many that nobody remembers writing.\n\n"
        "Paper dust drifts between the shelves, and RELIC kin live in it: KETTLEKIN brew in the "
        "reading rooms, PARASOLE hop along the aisles, and on rare nights a LAMPJINN rises from an "
        "old lamp.\n\n"
        "Pages come loose and float about on their own. The librarians leave them be.",
        "Welcome. Please keep your voice down, and your kin's.\f"
        "The pages are sleeping. Most of them." },

    [LORE_SCRIPTORA] = { LCH_LEGENDS, LSRC_LIBRARIAN, "SCRIPTORA",
        "At the heart of the Dust Library lives SCRIPTORA, a serpent made of living pages. It is "
        "the reason the books never rot: a RELIC kernel that has lived inside the library for so "
        "long that the whole collection has become its body.\n\n"
        "When a book is forgotten, SCRIPTORA reads it again. When a dream is forgotten, some say, "
        "SCRIPTORA writes it down.\n\n"
        "Wardens who reach the reading room at the back may answer it. It prefers the quiet ones.",
        "You want to know what lives in the back room.\f"
        "Everyone does, eventually. Very well." },
