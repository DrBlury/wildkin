    { MAP_CINDER_ROAD, 3, 18, "CINDER ROAD. West: LUMEN CITY. East: CINDERMOOR. Keep to the gravel!" },
    { MAP_CINDER_ROAD, 40, 18, "CINDERMOOR, town of smiths, just ahead. Home of the ANVIL HALL." },
    { MAP_CINDERMOOR, 2, 19, "CINDERMOOR. The ground is warm, the iron is honest." },
    { MAP_CINDERMOOR, 30, 8, "ANVIL HALL. Master: BRONWEN. METAL and BLAZE kin. Push, plate, prevail!" },
    { MAP_CINDERMOOR, 25, 6, "EMBER TUNNEL. Lava tube and old mine. Wardens only beyond the lava chamber." },
    { MAP_MOONVEIL, 22, 36, "MOONVEIL PATH. North: DREAMSPIRE. South: LUMEN CITY." },
    { MAP_MOONVEIL, 22, 3, "DREAMSPIRE ahead. Please dream quietly." },
    { MAP_DREAMSPIRE, 22, 39, "DREAMSPIRE, town of towers and long sleeps." },
    { MAP_DREAMSPIRE, 35, 9, "The DUST LIBRARY. Open at all hours. The books are always awake." },
    { MAP_DREAMSPIRE, 20, 8, "MIRROR HALL. Master: VESPER. DREAM kin. Mind which star you step on." },

    { MAP_CINDER_CROSSING, 3, 18, "CINDER BRIDGE — OUT. SURF OR WAIT FOR REPAIR." },
    { MAP_RAILHEAD, 3, 18, "RAILHEAD. Hearth in the bunk; foreman in the office." },
    { MAP_MISTFEN, 21, 57, "MISTFEN. The WARD LANTERN parts Moonveil mist." },
    { MAP_RAILHEAD_SHAFT, 8, 2, "COLLAPSED SHAFT\fThe Anvil Crest steadies the deep passage." },
    { MAP_COOLING_CHAMBER, 7, 11, "The sluice note reads: INTAKE, THEN RELEASE.\fA cooled seam holds until the mountain wakes." },
    { MAP_EMBER_SPAN, 8, 12, "IRON SPAN\fA high deck over molten stone. Keep to the rails." },
    { MAP_COOLING_CHAMBER, 16, 5, "An ash-root seam runs toward the old March.\fOnly Morwen's Lantern Crest parts the stone." },
    { MAP_RAILHEAD_SHAFT, 2, 9, "A copper seam returns toward Copperline.\fThe Anvil Crest opens this old mine gate." },
