/* world/far/trainers.inc -- Wardens: [TR_X] = { "WARDEN X", count, { species... }, { levels... }, prize, "intro", "lose" },. Owner: W-FAR. */
    /* cinder road */
    [TR_CR_OSKAR] = { "WARDEN OSKAR", 2, { SP_RIVETILLO, SP_SALAMBER }, { 27, 28 }, 1300,
                      "The ash here is warm enough to cook on. So is my team!",
                      "Hoo! You cooled us right down." },
    [TR_CR_MINA] = { "WARDEN MINA", 3, { SP_MAGNITICK, SP_STINGLET, SP_FULGECKO }, { 27, 28, 29 }, 1500,
                     "My MAGNITICK found you by your lantern clasps. Iron always gives you away!",
                     "Pulled right off the rails..." },
    [TR_CR_BRAND] = { "WARDEN BRAND", 3, { SP_CINDERUB, SP_SALAMBER, SP_SCORCHION }, { 28, 29, 30 }, 1600,
                      "Every ember in this brush is a kin that wants a bout. Me too!",
                      "Burned out. Good bout, though." },
    /* ember tunnel */
    [TR_ET_DELVE] = { "WARDEN DELVE", 3, { SP_DIGGET, SP_RIVETILLO, SP_LODEHORN }, { 29, 29, 30 }, 1800,
                      "Mind the lava, mind the rails, and mind ME!",
                      "Dug myself a hole there." },
    [TR_ET_ASHA] = { "WARDEN ASHA", 4, { SP_SQUEAKLE, SP_SALAMBER, SP_FORTADILLO, SP_MAGMAUL }, { 29, 30, 31, 31 }, 2100,
                     "The tunnel hums when CALDERON dreams. Can you feel it through your boots?",
                     "The hum's gone quiet. You did that." },
    /* anvil hall */
    [TR_AH_TOMAS] = { "WARDEN TOMAS", 2, { SP_RIVETILLO, SP_MAGNITICK }, { 29, 29 }, 1700,
                      "First plate, first bout! Strike while the iron's hot!",
                      "Cooled and quenched. Go on up." },
    [TR_AH_IRIS] = { "WARDEN IRIS", 3, { SP_SALAMBER, SP_LODEHORN, SP_FULGECKO }, { 30, 30, 30 }, 1900,
                     "Pumice floats on water and a good warden floats over any puzzle. Show me!",
                     "You've got a smith's patience." },
    [TR_AH_KORR] = { "WARDEN KORR", 4, { SP_SCORCHION, SP_FORTADILLO, SP_RIVETILLO, SP_SALAMBER }, { 31, 31, 31, 31 }, 2200,
                     "The Master is right behind me. You'll have to hammer through me first!",
                     "Tempered, not broken. Go and see BRONWEN." },
    [TR_MASTER_BRONWEN] = { "BRONWEN", 6,
                            { SP_LODEHORN, SP_SCORCHION, SP_FORTADILLO, SP_MAGMAUL, SP_FULGECKO, SP_FOUNDRAKE },
                            { 31, 31, 32, 33, 33, 34 }, 4000,
                            "Heat, hammer and patience. That's all a smith needs.",
                            "Well struck! That's the finest bout this anvil has rung with in years." },
    /* moonveil path */
    [TR_MV_LUNA] = { "WARDEN LUNA", 2, { SP_DOZLOTH, SP_PUFFOWL }, { 39, 39 }, 1600,
                     "Shh! My DOZLOTH is dreaming. Let's bout quietly.",
                     "It slept through the whole thing." },
    [TR_MV_ORIN] = { "WARDEN ORIN", 3, { SP_MANDRAGOR, SP_LUMOTH, SP_TANUKETTLE }, { 39, 40, 41 }, 1900,
                     "The moonpetals are open. That means it's bout o'clock!",
                     "The petals are closing. So am I." },
    [TR_MV_SELA] = { "WARDEN SELA", 3, { SP_SKYWISP, SP_DOZLOTH, SP_SOMNISLOTH }, { 40, 41, 42 }, 2000,
                     "I walked here in my sleep once. Now I train here awake!",
                     "Was that a dream? It felt like a loss." },
    /* mirror hall */
    [TR_MH_NELL] = { "WARDEN NELL", 2, { SP_MANDRAGOR, SP_LUMOTH }, { 40, 40 }, 2000,
                     "Which of us is the reflection? Only one way to find out!",
                     "I'm definitely the reflection." },
    [TR_MH_PERRIN] = { "WARDEN PERRIN", 3, { SP_DOZLOTH, SP_TANUKETTLE, SP_HOOTLORD }, { 40, 41, 41 }, 2300,
                       "You found the right pad! Now find the right move.",
                       "Every pad leads somewhere. Yours led here." },
    [TR_MH_OPAL] = { "WARDEN OPAL", 4, { SP_SOMNISLOTH, SP_MANDRAGOR, SP_LUMOTH, SP_HOOTLORD }, { 41, 41, 42, 42 }, 2600,
                     "VESPER sees every bout in the mirrors. Make this one worth watching!",
                     "She'll have enjoyed that. Go on." },
    [TR_MASTER_VESPER] = { "VESPER", 6,
                           { SP_SOMNISLOTH, SP_HOOTLORD, SP_TANUKETTLE, SP_LUMOTH, SP_MANDRAGOR, SP_SLUMBAKU },
                           { 42, 42, 43, 43, 44, 45 }, 5000,
                           "Every kin dreams. Tonight, let's dream the same bout.",
                           "Wide awake at last. You out-dreamed me." },
    /* dust library */
    [TR_DL_QUILL] = { "WARDEN QUILL", 3, { SP_KETTLEKIN, SP_PARASOLE, SP_WICKLET }, { 40, 41, 42 }, 2200,
                      "Silence in the library! ...Except for bouts. Bouts are fine.",
                      "Overdue for a rest, I think." },

