/* world/east/signs.inc -- Signs: { MAP_X, x, y, "text" },. Owner: W-EAST. */
    { MAP_TOWN, 25, 25, "LAND OFFICE\fDeeds, surveys and plots for sale. REEVE, land agent." },
    { MAP_COPPERLINE, 3, 16, "COPPERLINE ROAD\fWEST: BRAMBLEWOOD. EAST: LUMEN CITY." },
    { MAP_COPPERLINE, 23, 33, "ACCORD CHECKPOINT\fThe March is under quarantine. Only four-crest wardens may enter." },
    { MAP_COPPERLINE, 40, 19, "EAST: LUMEN CITY\fThe lamp-lit city. Home of the VOLT HALL." },
    { MAP_LUMEN, 23, 2, "NORTH GATE\fThe fog of MISTFEN makes wanderers forget the road home. Seek the WARD LANTERN." },
    { MAP_LUMEN, 2, 19, "WEST GATE\fCOPPERLINE ROAD to BROOKMILL and BRAMBLEWOOD." },
    { MAP_LUMEN, 51, 22, "EAST GATE\fThe spring flood washed out CINDER CROSSING. SURF gets you through." },
    { MAP_LUMEN, 17, 19, "LUMEN CITY\fThe lamp-lit city. Its BEACON has not gone dark in two hundred years." },
    { MAP_LUMEN, 43, 7, "CLOCKWORK SPIRE\fThe clockmakers' tower. Visitors welcome. Mind the gears." },
    { MAP_ELDERWOOD, 29, 2, "ELDERWOOD HEART\fThe oldest trees in the Vale. Tread softly." },
    { MAP_BROOKMILL_TRAIL, 3, 16, "BROOKMILL TRAIL\fThe Brook was the Vale's first trade road. East: BROOKMILL." },
    { MAP_BROOKMILL_TRAIL, 58, 16, "THE MILL IS NEAR\fBrookmill carpenters build the Vale's bridges." },
    { MAP_BROOKMILL_TRAIL, 24, 22, "OLD TOLL BOOTH\fThe first traders left copper coins here. Search the rookery below." },
    { MAP_BROOKMILL, 3, 16, "BROOKMILL\fHearth, mill, guild, millpond. The guild's ferrymen use the old Brook." },
    { MAP_BROOKMILL, 35, 16, "EAST: COPPERLINE\fThe miners' road leads to Lumen's Volt Hall." },
    { MAP_BROOKMILL, 34, 30, "TRAM DEPOT\fBrookmill's next great project. The rails aren't laid yet." },
    { MAP_COPPERLINE, 24, 8, "COPPERLINE MINE\fDark but passable. LIGHT reveals its lost side gallery." },
    { MAP_ELDERWOOD, 29, 2, "THE ELDER'S PROMISE\fThe grove waits until the March is healed. Come back after OSSUREX." },
    { MAP_LUMEN, 43, 9, "SPIRE CROWN\fThe great clock awaits the end of the March. STRENGTH alone is not enough." },
