/* world/east/lore.inc -- Lorebook entries: [LORE_X] = { LCH_..., LSRC_..., "TITLE", "page", "talk" },. Owner: W-EAST. */

    [LORE_COPPERLINE] = { LCH_PLACES, LSRC_MINER, "COPPERLINE ROAD",
        "East of Bramblewood the ground turns stony and the road runs past an old copper mine. For a "
        "hundred years the Copperline was the busiest road in the Vale: carts of ore went east to "
        "Lumen and came back full of lamps.\n\n"
        "The seam ran dry in the old miner's youth, and the shaft is boarded shut. The headframe "
        "still stands, and so do the carts, green with patina. MAGNITICK nibble the slag heaps for "
        "iron, RIVETILLO sun their plates on the rocks and STATICKO cling to anything metal.\n\n"
        "South, the road forks toward the grey ASHEN FIELDS. East, it runs to LUMEN CITY.",
        "HESK: Sit, sit. You're walking the Copperline, you should know what it was.\f"
        "Carts, noise, lamps going east, ore coming west. Then the seam ran dry. Listen..." },

    [LORE_MAGNETITE] = { LCH_TYPES, LSRC_MINER, "METAL KIN",
        "METAL kin grow kernels of magnetite, a black iron oxide that is a natural magnet. They pump "
        "from magnetic fields and from the currents those fields stir up, and they build iron armour "
        "around themselves as they grow.\n\n"
        "Water rusts them and heat softens them, which is why BLAZE and TIDE moves hurt. Poison has "
        "nothing to bite on. A strong magnetic field bends the paths of cosmic rays, so METAL kin "
        "shrug off ASTRAL moves.\n\n"
        "REAL SCIENCE: some bacteria build chains of tiny magnetite crystals and use them as a "
        "compass. Birds and turtles may sense the Earth's field too.\n\n"
        "VALE ONLY: a kernel that pumps from a magnetic field.",
        "HESK: See how the MAGNITICK go for the slag? Iron. They can smell it.\f"
        "Or feel it. My daughter says they carry a little compass inside." },

    [LORE_LUMEN_CITY] = { LCH_PLACES, LSRC_LUMEN_GUIDE, "LUMEN CITY",
        "Lumen is the lamp-lit city of the east: cobbled streets, a stone canal, an old city wall and "
        "more lamps than anyone has counted twice. It grew rich on Copperline ore and SPARK kin.\n\n"
        "The VOLT HALL stands in the west quarter, where MASTER FARA trains SPARK kin. The "
        "RESONANCE WORKS in the east quarter catches the energy kin spill in bouts. The CLOCKWORK "
        "SPIRE, south of the boulevard, is older than all of it.\n\n"
        "Gates lead north to MOONVEIL PATH, east to CINDER ROAD and west to the COPPERLINE.",
        "GUIDE: Welcome, welcome! First time in LUMEN? Then you need the tour.\f"
        "Don't worry, it's short. The city isn't. The tour is." },

    [LORE_LUMEN_BEACON] = { LCH_PLACES, LSRC_LUMEN_GUIDE, "THE BEACON",
        "In the market square stands the LUMEN BEACON, a copper lattice tower with a glass globe on "
        "top. Inside the globe a small storm has flickered for two hundred years.\n\n"
        "The story goes that a brimming STORMHAWK once took shelter in the square, and the city's "
        "wardens bouted it for three days and nights. What it spilled was caught in the globe, and "
        "it never went out. Lumen has kept a SPARK warden on watch at the Beacon ever since.",
        "GUIDE: And that is the BEACON. Don't touch the glass. People do. Every day.\f"
        "Let me tell you where the storm inside came from." },

    [LORE_CITY_LAMPS] = { LCH_ENERGY, LSRC_LAMPLIGHTER, "LUMEN'S LAMPS",
        "Lumen's street lamps burn no oil. Each globe is a jar of stored charge, topped up at dusk by "
        "a lamplighter and a SPARK kin who spills a little surplus into it after a friendly bout.\n\n"
        "REAL SCIENCE: a Leyden jar is a glass jar lined with metal foil inside and out. It stores "
        "electric charge, and it was the first capacitor.\n\n"
        "VALE ONLY: a kin's spilled surplus caught in a jar and let out slowly as light.",
        "LAMPLIGHTER: You want to know how a lamp works without a flame? Easy.\f"
        "Well. Easy to say." },

    [LORE_DYNAMOS] = { LCH_ENERGY, LSRC_TINKER, "DYNAMOS",
        "A dynamo turns motion into current. Spin a magnet near a coil of wire and the changing field "
        "pushes charge around the coil. Lumen's bikes carry small dynamos in their hubs to light "
        "their lamps, and the Works uses big ones.\n\n"
        "REAL SCIENCE: this is electromagnetic induction, found in 1831. Almost every power station "
        "on Earth still works this way.\n\n"
        "VALE ONLY: SPARK and METAL kin do it without the wire.",
        "VEX: Oh! A visitor! Mind the coils. Do you know what a dynamo is?\f"
        "No? Wonderful. Sit down." },

    [LORE_VOLT_HALL] = { LCH_HALLS, LSRC_VOLT_GUIDE, "THE VOLT HALL",
        "The VOLT HALL is Lumen's Hall, the home of SPARK kin and their wardens. Its Master, FARA, "
        "rebuilt its floor into a maze of pylons and crackling barriers.\n\n"
        "Floor switches flip the barriers: each switch lowers or raises every barrier of its own "
        "colour. The trick is the order. Wardens who beat FARA earn the VOLT CREST, which lets their "
        "SPARK kin lend their LIGHT in dark places.",
        "GUIDE: Hey, challenger! First time in the VOLT HALL? Let me explain the floor.\f"
        "It will save you a lot of walking into barriers. Everyone does it." },

    [LORE_VOLT_CREST] = { LCH_HALLS, LSRC_STORY, "THE VOLT CREST",
        "You beat MASTER FARA and earned the VOLT CREST: a copper bolt in a ring of glass.\n\n"
        "The Wardens' Accord says that a warden who holds a crest may ask their kin for field help. "
        "With the VOLT CREST, a SPARK kin in your team can light the way in dark caves.\n\n"
        "The Keeper says the Ossuary opens only for a warden with all six crests.",
        0 },

    [LORE_ELDERWOOD] = { LCH_PLACES, LSRC_GROVE, "ELDERWOOD HEART",
        "South of Bramblewood, past the boulders, lies the heart of the old forest. The trees here "
        "have never been cut. In the glade at the centre stands the ELDER, an oak so old its roots "
        "are said to drink from springs no one has found.\n\n"
        "TRUFFLOAR root in the loam, GALESQUIRL glide between the crowns and MYCOLOSSUS walk slowly "
        "through the ferns. At night the GLOWCAPS light the forest floor pink.",
        "KEEPER: You pushed the stones aside to come in here? Then you mean it.\f"
        "Let me tell you where you're standing." },

    [LORE_SYLVARCH] = { LCH_LEGENDS, LSRC_GROVE, "SYLVARCH",
        "SYLVARCH is the great stag of the Elderwood, BLOOM and BEAST, with a living forest in its "
        "antlers. It pumps from sunlight like any plant, but so much of it that the whole glade grows "
        "greener when it passes.\n\n"
        "In the burning years, the story goes, SYLVARCH lay down in the Elder's shade and let the "
        "fire burn around the glade but never into it. The altar by the Elder marks the spot.",
        "KEEPER: Have you seen the altar? The antlers carved on it?\f"
        "There is a story that goes with them." },

    [LORE_CLOCKWORK_SPIRE] = { LCH_PLACES, LSRC_CLOCKMAKER, "THE CLOCKWORK SPIRE",
        "The Spire was built by Lumen's clockmakers before the city had a wall. Its gears turned the "
        "hands of every clock in the city by rods under the streets.\n\n"
        "One winter the great clock stopped, and the clockmakers sealed the stair to the Crown with a "
        "stone rather than say why. The clocks of Lumen have kept their own time ever since.",
        "HORA: A visitor! Nobody climbs the Spire any more. Do you like clocks?\f"
        "Good. Then you'll like this." },

    [LORE_HOROLOGOS] = { LCH_LEGENDS, LSRC_CLOCKMAKER, "HOROLOGOS",
        "The clockmakers' secret: the Spire's great clock was never a machine. It was a kin. "
        "HOROLOGOS, METAL and RELIC, a titan of gears whose kernel is lost somewhere inside a "
        "century of brass.\n\n"
        "It pumped from the hum of its own ticking. When the city grew loud it grew restless, and "
        "the clockmakers sealed it in the Crown to let it sleep. HORA thinks it is waiting for a "
        "warden strong enough to move the stone.",
        "HORA: You moved nothing yet, I see. Good. Then I can tell you why the stair is sealed.\f"
        "It isn't a clock up there. Not really." },
    [LORE_BROOK_TOLL] = { LCH_PLACES, LSRC_TOLL, "THE OLD TOLL", "The Brook was the Vale's first trade road. The old bridge is still used by herons and wardens. A dark hollow runs beneath it.", "TOLL KEEPER: Before the rails, this bridge was how copper reached the valley." },
    [LORE_BROOK_HERONS] = { LCH_PLACES, LSRC_HERON, "THE ROOKERY", "The herons nest in the dead trees downstream. PEBBOTTER juggle pebbles to attract them; neither has learned to stop stealing from the other.", "HERON WATCHER: Listen for their wings when the Brook is quiet." },
    [LORE_BROOK_WHEEL] = { LCH_PLACES, LSRC_MILLER, "WATER POWER", "The mill wheel uses the Brook's fall to turn a great cog. TIDE kin sometimes push it through the dry months. Lumen's rivets hold the vanes together.", "ADA: A mill must turn even when the brook is low." },
    [LORE_BROOK_SONG] = { LCH_PLACES, LSRC_FIDDLER, "THE BROOK'S SONG", "The fiddlers of Brookmill say the Brook sings a different tune after dark. KOIRIN follow its old falls back to the millpond.", "FIDDLER: It sounds like a tune if you wait long enough." },
    [LORE_COPPER_RUSH] = { LCH_PLACES, LSRC_COPPER_RUSH, "THE COPPER RUSH", "The first copper miners laid rails by lantern light. The vein ran dry, but a side gallery still shows their survey marks.", "MINE BOSS: The tablets still tell the old miners' story." },
