    /* COPPERLINE ROAD */
    PERSON(MAP_COPPERLINE, 20, 11, HERMIT, DOWN, LOOK, MINER, LSRC_MINER, "OLD MINER HESK", 0),
    PERSON_KIN(MAP_COPPERLINE, 35, 17, VILLAGER, LEFT, WANDER, TALK, NO_LORE, SP_MAGNITICK, "PROSPECTOR",
               "My MAGNITICK finds iron better than any map. It also eats my tent pegs."),
    PERSON(MAP_COPPERLINE, 27, 20, KID, DOWN, WANDER, TALK, NO_LORE, "KID",
           "I'm walking all the way to LUMEN! My big sister says they have a BIKE SHOP there."),
    WARDEN(MAP_COPPERLINE, 22, 15, WARDEN_A, LEFT, 2, TR_DUNN, SP_MAGNITICK, "The old seam's dry, but the bouts never are."),
    WARDEN(MAP_COPPERLINE, 9, 16, WARDEN_B, DOWN, 2, TR_PIA, NO_KIN, "Walk on, walk on. You earned it."),
    WARDEN(MAP_COPPERLINE, 19, 27, WARDEN_A, RIGHT, 2, TR_ROSS, SP_MANDRAGOR, "MANDRAGOR still hums your name."),
    WARDEN(MAP_COPPERLINE, 36, 19, WARDEN_B, DOWN, 2, TR_JUNO, SP_BLINKET, "Tell FARA that JUNO sent you!"),
    /* LUMEN CITY */
    PERSON(MAP_LUMEN, 26, 4, GUIDE, LEFT, STILL, TALK, LSRC_LUMEN_GUIDE, "CITY GUIDE",
           "Welcome to LUMEN! The HALL crowns the hill, the BEACON waits down the steps, and the WORKS hum in the Cut below."),
    PERSON(MAP_LUMEN, 26, 11, VILLAGER, LEFT, PACE_H, TALK, LSRC_LAMPLIGHTER, "LAMPLIGHTER",
           "Every lamp in Lumen, topped up by sunset. Two hundred and twelve of them... and two more in the old WELL garden, if you know the way through the wall."),
    PERSON_KIN(MAP_LUMEN, 16, 41, KID, DOWN, WANDER, TALK, NO_LORE, SP_KETTLEKIN, "KID",
               "KETTLEKIN makes tea when it's happy. It's always happy! I have SO much tea."),
    PERSON(MAP_LUMEN, 9, 35, FISHER, DOWN, LOOK, TALK, NO_LORE, "CANAL FISHER",
           "Nothing bites in the canal. I come for the quiet, and the lamps on the water."),
    PERSON(MAP_LUMEN, 45, 18, SCIENTIST, DOWN, LOOK, TALK, NO_LORE, "ENGINEER",
           "The RESONANCE WORKS can turn a kin's surplus into pure energy. Ask at the front desk!"),
    PERSON(MAP_LUMEN, 49, 18, ELDER, UP, LOOK, TALK, NO_LORE, "CLOCKWATCHER",
           "The SPIRE's stair was sealed with a great stone when the clock stopped. Only real STRENGTH moves it."),
    WARDEN(MAP_LUMEN, 53, 34, WARDEN_A, LEFT, 2, TR_ARLO, SP_KETTLEKIN, "Come back for tea sometime."),
