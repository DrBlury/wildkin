    [LORE_CRAFT_MAILLARD] = { LCH_CRAFTING, LSRC_CHEF, "THE BROWNING",
        "Why does a toasted bun taste better than a raw one? When food gets hot "
        "and dry, sugars and proteins start to react with each other. Hundreds "
        "of new flavour molecules form, and the surface turns golden brown.\n\n"
        "Cooks call it browning. It only starts above about 140 degrees, which "
        "is why a wet pan never browns anything: water can't get hotter than "
        "100 degrees until it has boiled away.\n\n"
        "That's the secret of the pan toss. Each toss turns the food so every "
        "side meets the hot metal, without burning one side black.\n\n"
        "REAL SCIENCE: this is the Maillard reaction, named after the chemist "
        "Louis-Camille Maillard.\n\n"
        "VALE ONLY: kin that sniff the air when you toss a pan.",
        "Hear that sizzle? That's the water leaving. Once it's gone, the real "
        "cooking starts: the golden-brown part!\f"
        "Toss it at the right moment and every side gets its turn on the heat." },

    [LORE_CRAFT_MEALS] = { LCH_CRAFTING, LSRC_CHEF, "WHY MEALS HELP",
        "A kernel pumps its body with light and warmth, but the body itself "
        "is built from ordinary stuff: proteins, fats and sugars, the same as "
        "yours.\n\n"
        "A good meal gives the body what it needs to hold a strong field. "
        "Sugars are quick fuel for a hard bout. Proteins rebuild what the "
        "last bout wore down. Warm, spicy food speeds the blood, and the "
        "kernel pumps a little harder.\n\n"
        "The effect fades after a few bouts, the same way a good breakfast "
        "does. A better-made dish lasts longer and helps more.\n\n"
        "REAL SCIENCE: muscles really do run on sugar first and fat later, "
        "and protein repairs them after hard work.\n\n"
        "VALE ONLY: kernels that pump harder after a CHILI POT.",
        "Kin work hard for you. Feed them well and they'll work harder!\f"
        "One good dish at a time, mind. Eat another and it takes the place of "
        "the first." },

    [LORE_CRAFT_CANDY] = { LCH_CRAFTING, LSRC_CHEF, "KERNEL CANDY",
        "Glow-bee honey is so full of sugar that it can't hold it all. Leave "
        "it cold for long enough and the extra sugar comes out as crystals: "
        "the honey sets hard and cloudy.\n\n"
        "Stir in fine MOTE DUST while it sets, and each sugar crystal grows "
        "around a speck of mote. The result is KERNEL CANDY: sweet glass "
        "that a kernel can crunch and absorb whole. It grows one level, just "
        "like a SUNSEED.\n\n"
        "REAL SCIENCE: honey is a supersaturated sugar solution. It really "
        "crystallises over time, and crystals really do grow around tiny "
        "seeds.\n\n"
        "VALE ONLY: mote dust, and kin that grow from candy.",
        "My best-kept secret: glow-bee honey, a pinch of MOTE DUST, and "
        "patience. Kin go wild for it.\f"
        "The honey wants to crystallise anyway. We just give it something "
        "to grow on." },

    [LORE_CRAFT_ENZYMES] = { LCH_CRAFTING, LSRC_BREWER, "THE WARM BREW",
        "A glow tonic is not boiled. It is warmed, gently, and held there.\n\n"
        "The light in a tonic comes from an enzyme: a tiny protein machine "
        "that helps luciferin glow. Enzymes work faster as they warm up, but "
        "only to a point. Too hot, and the machine unfolds like a cooked egg "
        "white and never works again. Too cool, and it barely works at all.\n\n"
        "So a brewer keeps the cauldron in a narrow band of heat, nudging the "
        "fire up and down as the brew thickens. That band drifts as the brew "
        "changes, which is why brewing takes a steady hand.\n\n"
        "REAL SCIENCE: every enzyme has an optimum temperature. Above it, the "
        "protein denatures.\n\n"
        "VALE ONLY: tonics that kernels drink as light.",
        "Gently, gently. Heat is a tool, not a hammer.\f"
        "Keep the brew in the green band. Too cold and it sulks, too hot and "
        "the glow cooks away. You can't undo a cooked brew." },

    [LORE_CRAFT_BUBBLES] = { LCH_CRAFTING, LSRC_BREWER, "BOTTLING THE FIZZ",
        "When a brew is ready, big bubbles rise and burst on top. Each one "
        "carries a little of the brew's spark up with it.\n\n"
        "A good brewer bottles just as a big bubble is fullest: the brew "
        "under it is as lively as it will ever be. Wait too long and the "
        "bubble bursts, and the spark escapes into the air.\n\n"
        "REAL SCIENCE: gas dissolves less well in hot liquid, so warm brews "
        "give up their gas as bubbles. A surface film can stretch a bubble "
        "big before it pops.\n\n"
        "VALE ONLY: the spark a kernel can taste.",
        "Watch the big bubble swell... swell... now! Cork it!\f"
        "Every brewer misses a few. The trick is to watch, not to guess." },

    [LORE_CRAFT_ANNEALING] = { LCH_CRAFTING, LSRC_SMITH, "ANNEALING GLASS",
        "A heartglass lantern is blown hot and must cool slowly. If the "
        "outside cools faster than the inside, the glass is left full of "
        "stress, and one knock shatters it.\n\n"
        "So smiths rest new lanterns in a warm oven and let the heat fade "
        "over hours. The stress relaxes out, and the glass rings clear when "
        "you tap it. A kernel can rest in glass like that. It can't rest in "
        "glass that hums with strain.\n\n"
        "REAL SCIENCE: this is annealing, and real glassworks do it for every "
        "bottle and window.\n\n"
        "VALE ONLY: heartglass, and kin that listen for its ring.",
        "Tap it. Hear that ring? That's a lantern a kin will trust.\f"
        "Rush the cooling and you get a dull clunk. Nobody wants to sleep in "
        "a clunk." },

    [LORE_CRAFT_QUENCH] = { LCH_CRAFTING, LSRC_SMITH, "THE QUENCH",
        "Iron frames for lanterns are hammered while they glow, then plunged "
        "into water. The hiss is the quench.\n\n"
        "Hot iron is soft because its atoms sit in a roomy pattern. A sudden "
        "chill traps them in a tight, strained pattern before they can "
        "settle, and the iron comes out hard. Keep a steady beat with the "
        "hammer so the metal is even all the way through, or it cracks in the "
        "water.\n\n"
        "REAL SCIENCE: quenching steel really hardens it, by trapping its "
        "atoms in a crystal form called martensite.\n\n"
        "VALE ONLY: forges that CINDERUB keep lit all night.",
        "Strike on the beat! Even blows make even metal.\f"
        "Then, hsssss. The water locks the iron in place. Miss the beat and "
        "the quench finds the weak spot." },
