/* world/west/npcs.inc -- People: PERSON(...), PERSON_KIN(...), WARDEN(...),. Owner: W-WEST. */
    /* SALTWIND TRAIL */
    PERSON(MAP_SALTWIND, 5, 22, GARDENER, DOWN, LOOK, SALT_RAKER, LSRC_SALT_RAKER, "SALT RAKER", 0),
    PERSON(MAP_SALTWIND, 43, 28, SCIENTIST, LEFT, LOOK, TALK, LSRC_BIRDER, "BIRDWATCHER",
           "Seventy-one gulls today. Seventy-two. No, that one is a STORMBRELA."),
    WARDEN(MAP_SALTWIND, 14, 17, WARDEN_A, DOWN, 2, TR_WEST_NILS, SP_PEBBOTTER, "Port Brine's just west. Tell them Nils sent you."),
    WARDEN(MAP_SALTWIND, 24, 21, WARDEN_B, DOWN, 2, TR_WEST_PERLA, SP_CRANICRAB, "My CRANICRAB found a coin in the dunes once. Never again."),
    WARDEN(MAP_SALTWIND, 25, 27, WARDEN_A, LEFT, 4, TR_WEST_DUNE, NO_KIN, "The dunes move a little every night. So do I."),
    WARDEN(MAP_SALTWIND, 42, 11, WARDEN_B, DOWN, 1, TR_WEST_CORRIE, NO_KIN, "Watch the bay long enough and you'll see the ferry."),
    /* PORT BRINE */
    PERSON(MAP_PORT_BRINE, 30, 33, GUIDE, LEFT, LOOK, FERRY, NO_LORE, "FERRYMAN", 0),
    PERSON(MAP_PORT_BRINE, 18, 24, FISHER, UP, LOOK, TALK, LSRC_FISHMONGER, "FISHMONGER",
           "Mackerel for the inn, sprats for the gulls, and the crab stays."),
    PERSON(MAP_PORT_BRINE, 6, 27, HERMIT, LEFT, LOOK, LIGHTKEEPER, LSRC_LIGHTKEEPER, "LIGHTKEEPER", 0),
    PERSON(MAP_PORT_BRINE, 34, 20, GRAN, DOWN, WANDER, TALK, NO_LORE, "NET MENDER",
           "The Hall Master MAREN was a fisher's girl. Now look at her. Still smells of the sea, though."),
    PERSON(MAP_PORT_BRINE, 20, 8, KID, DOWN, WANDER, TALK, NO_LORE, "KID",
           "I rode the current in the Hall all the way back to the door. Six times! It's the best."),
    PERSON_KIN(MAP_PORT_BRINE, 35, 25, VILLAGER, LEFT, LOOK, TALK, NO_LORE, SP_TORRENTTER, "DOCKHAND",
               "My TORRENTTER hauls the crates. I hold the clipboard. It's a partnership."),
    PERSON(MAP_PORT_BRINE, 11, 14, HERMIT, DOWN, LOOK, TALK, NO_LORE, "OLD SMUGGLER",
           "Found the crack in the quay wall, eh? Brine lit its lamp to warn ships off the rocks. "
           "We lit ours to bring them in. Don't tell the lightkeeper. She knows."),
    /* interiors */
    PERSON(MAP_BRINE_HEARTH, 5, 2, HEALER, DOWN, STILL, TENDER, NO_LORE, "TENDER NELL", 0),
    PERSON(MAP_BRINE_SHOP, 1, 2, SHOPKEEPER, DOWN, STILL, BRINE_SHOP, NO_LORE, "CLERK", 0),
    PERSON(MAP_HARBOR_OFFICE, 7, 3, ELDER, DOWN, STILL, HARBORMASTER, LSRC_HARBORMASTER, "HARBOR MASTER", 0),
    PERSON(MAP_HARBOR_OFFICE, 2, 6, VILLAGER, RIGHT, LOOK, TALK, NO_LORE, "CLERK",
           "The telegraph says fair weather. The gulls say otherwise. I trust the gulls."),
    PERSON(MAP_BRINE_INN, 1, 2, BAKER, DOWN, STILL, CHEF, NO_LORE, "COOK", 0),
    PERSON(MAP_BRINE_INN, 3, 2, VILLAGER, DOWN, STILL, BRINE_INNKEEPER, NO_LORE, "INNKEEPER", 0),
    PERSON(MAP_BRINE_INN, 9, 4, WARDEN_A, LEFT, LOOK, TALK, NO_LORE, "GUEST",
           "I came for the Hall and stayed for the fish pie. Third week now."),
    PERSON(MAP_BRINE_HOUSE, 6, 3, ELDER, DOWN, LOOK, SKIPPER, LSRC_SKIPPER, "OLD SKIPPER", 0),
    PERSON(MAP_BRINE_HOUSE, 8, 5, KID_B, LEFT, WANDER, TALK, NO_LORE, "GRANDSON",
           "Grandpa says the Moon pulls the sea. I pulled the cat. That did not go well."),
    /* the CURRENT HALL */
    PERSON(MAP_CURRENT_HALL, 5, 14, VILLAGER, DOWN, LOOK, HALL_GUIDE, LSRC_HALL_GUIDE, "HALL GUIDE", 0),
    WARDEN(MAP_CURRENT_HALL, 3, 6, WARDEN_A, DOWN, 3, TR_HALL_RILL, NO_KIN, "Ride on. The water knows the way. Mostly."),
    WARDEN(MAP_CURRENT_HALL, 12, 6, WARDEN_B, LEFT, 3, TR_HALL_EDDY, NO_KIN, "Up is MAREN. Down is the door. Choose well."),
    WARDEN(MAP_CURRENT_HALL, 1, 15, WARDEN_A, RIGHT, 1, TR_HALL_WAVE, NO_KIN, "This nook is quiet. Good for thinking."),
    PERSON(MAP_CURRENT_HALL, 7, 2, GUIDE, DOWN, STILL, MAREN, NO_LORE, "MASTER MAREN", 0),
    /* the SEA ROUTE */
    WARDEN(MAP_SEA_ROUTE, 8, 11, WARDEN_A, RIGHT, 3, TR_WEST_SKIM, NO_KIN, "Next time I'm bringing a boat."),
    WARDEN(MAP_SEA_ROUTE, 29, 20, WARDEN_B, LEFT, 4, TR_WEST_MARISOL, SP_TORRENTTER, "The tide's coming in. My sandbar's going out."),
    WARDEN(MAP_SEA_ROUTE, 12, 30, WARDEN_A, DOWN, 2, TR_WEST_BRAM, NO_KIN, "Four tides, zero wins. Good swimming, warden."),
    PERSON(MAP_SEA_ROUTE, 23, 5, FISHER, DOWN, LOOK, TALK, NO_LORE, "ANGLER",
           "At night something BIG swims under this pier. The line goes tight, then it just... sings."),
    /* GULL ISLE */
    PERSON(MAP_GULL_ISLE, 7, 24, GRAN, UP, LOOK, ODA, LSRC_ODA, "ODA", 0),
    PERSON(MAP_GULL_ISLE, 30, 6, GUIDE, UP, LOOK, FERRY, NO_LORE, "FERRYMAN", 0),
    PERSON(MAP_GULL_ISLE, 16, 12, KID_B, DOWN, WANDER, TALK, NO_LORE, "ISLAND KID",
           "The bell rang last night! Gran says don't go in the cave. I didn't. Much."),
    PERSON(MAP_GULL_ISLE, 13, 12, FISHER, LEFT, LOOK, TALK, NO_LORE, "FISHER",
           "Salted, dried, sold in Brine. That's island life. Could do with more SALT, mind."),
    WARDEN(MAP_GULL_ISLE, 34, 24, WARDEN_A, LEFT, 3, TR_WEST_TANSY, SP_CRYPTCLAW, "Grandmother Oda says the bell only rings for people who listen."),
    WARDEN(MAP_GULL_ISLE, 22, 9, WARDEN_B, DOWN, 2, TR_WEST_OKE, NO_KIN, "See you next ferry, warden."),
    PERSON(MAP_GULL_HOUSE, 6, 4, HERMIT, DOWN, LOOK, TALK, LSRC_ISLE_ELDER, "ISLE ELDER",
           "The sea gives, the sea takes. Mostly it gives fish."),
