/* world/west/signs.inc -- Signs: { MAP_X, x, y, "text" },. Each sits on a SIGNPOST decor. Owner: W-WEST. */
    { MAP_SALTWIND, 44, 30, "SALTWIND TRAIL\fWEST: PORT BRINE. EAST: REEDWICK.\fMind the dune ledges: they only go one way." },
    { MAP_SALTWIND, 4, 18, "SALTWIND SALT PANS\fThe sun and the wind do the work. Please don't walk in the brine." },
    { MAP_PORT_BRINE, 23, 7, "CURRENT HALL\fHALL MASTER MAREN. The water only flows one way. So should you." },
    { MAP_PORT_BRINE, 45, 21, "PORT BRINE\fWhere the Vale meets the sea. Mind the gulls." },
    { MAP_PORT_BRINE, 18, 25, "HARBOR OFFICE\fFerry to GULL ISLE: 500c, or show your FERRY PASS." },
    { MAP_PORT_BRINE, 15, 16, "BRINE HEARTH HALL\fRest your kin by the hearth. Free, as it has always been." },
    { MAP_PORT_BRINE, 9, 4, "SAILORS' GARDEN\fOne flower for every boat the tide kept.\fThe gulls are asked not to eat them." },
    { MAP_SEA_ROUTE, 17, 4, "SEA ROUTE\fOpen water to GULL ISLE. A strong TIDE kin can carry you (SURF).\fNo SURF? The ferry sails from the HARBOR OFFICE." },
    { MAP_GULL_ISLE, 18, 3, "GULL ISLE\fPopulation: eleven people, one lighthouse, too many gulls." },
    { MAP_GULL_ISLE, 28, 25, "SEA CAVE\fThe fishers call it the DROWNED BELL. Listen at night." },
    { MAP_HERON_FEN, 37, 18, "BOARDWALK CLOSED - AWAITING LUMEN RIVETS.\fLumen's lamps went out west; the fen needs new planks." },
    { MAP_HERON_FEN, 56, 29, "HERON FEN\fEast: MIRROR LAKE. West: REEDWICK.\fThe rookery stands above the reeds." },
    { MAP_REEDWICK, 35, 18, "REEDWICK\fEast: HERON FEN. West: SALTWIND TRAIL." },
    { MAP_REEDWICK, 2, 29, "BOATBUILDER'S SLIP\fA wreck rests beyond the channel. Only SURF can reach it." },
    { MAP_PORT_BRINE, 4, 11, "NORTHERN WATERS - SURF ONLY\fGreywater Fjord lies beyond the buoy line." },
    { MAP_SALTWIND, 34, 13, "CLIFF CACHE\fA boulder fell across the old lighthouse path. STRENGTH could shift it." },
    { MAP_REED_TUNNEL, 1, 7, "REED TUNNEL\fEAST: sluice. The arrows carry you south to safety.\fThrow the switch before the east gate." },
    { MAP_TIDAL_UNDERFLOW, 5, 10, "TIDAL UNDERFLOW\fThe east channel needs SURF. West: fen. East: Reedwick sluice and Port Brine." },
    { MAP_TIDAL_UNDERFLOW, 21, 10, "EAST BANK\fNorth ladder: REEDWICK. South ladder: PORT BRINE.\fThe current never shuts the west landing." },
    { MAP_TIDAL_UNDERFLOW, 9, 4, "ROOTWAYS LADDER\fTide Crest opens the west-bank root passage. East bank still needs SURF.\fReturn by this ladder or the Fen stairs." },

