/* world/west/trainers.inc -- Wardens: [TR_X] = { "WARDEN X", count, { species... }, { levels... }, prize, "intro", "lose" },. Owner: W-WEST. */
    /* SALTWIND TRAIL (levels 20-23) */
    [TR_WEST_NILS] = { "WARDEN NILS", 2, { SP_PEBBOTTER, SP_PUFFOWL }, { 20, 21 }, 640,
        "The trail to PORT BRINE? Sure. Toll's one bout!",
        "Toll paid. In full. Go on." },
    [TR_WEST_PERLA] = { "WARDEN PERLA", 3, { SP_CRANICRAB, SP_PARASOLE, SP_BUBBLIN }, { 20, 21, 21 }, 700,
        "Salt in the air, sand in my boots, and a bout on the way. Perfect day!",
        "Even my crab is sulking. Good bout." },
    [TR_WEST_DUNE] = { "WARDEN DUNE", 2, { SP_TUXFLAKE, SP_STORMBRELA }, { 21, 22 }, 820,
        "You hopped the dune ledge! No going back now. Only forward. Into me.",
        "The wind changed. So did my luck." },
    [TR_WEST_CORRIE] = { "WARDEN CORRIE", 3, { SP_ZAPPET, SP_SKYWISP, SP_PEBBOTTER }, { 21, 22, 23 }, 900,
        "From up here you can see the whole bay. And every warden who walks it.",
        "I saw that coming. I still couldn't stop it." },
    /* SEA ROUTE (levels 23-27) */
    [TR_WEST_SKIM] = { "WARDEN SKIM", 3, { SP_JELLUME, SP_PEBBOTTER, SP_BUBBLIN }, { 23, 23, 24 }, 1150,
        "Swam all the way out here to train. Where's YOUR towel?",
        "Glub. I mean, good bout." },
    [TR_WEST_MARISOL] = { "WARDEN MARISOL", 3, { SP_TORRENTTER, SP_CRANICRAB, SP_STORMBRELA }, { 24, 25, 25 }, 1250,
        "This sandbar is mine until the tide says otherwise!",
        "The tide said otherwise." },
    [TR_WEST_BRAM] = { "WARDEN BRAM", 4, { SP_LURELING, SP_TUXFLAKE, SP_JELLUME, SP_MEDUSHOCK }, { 24, 24, 25, 26 }, 1400,
        "Four kin, four tides. Let's see which one takes you.",
        "None of them. Huh." },
    /* GULL ISLE (levels 25-29) */
    [TR_WEST_TANSY] = { "WARDEN TANSY", 3, { SP_CRYPTCLAW, SP_STORMBRELA, SP_TUXFLAKE }, { 26, 26, 27 }, 1400,
        "Nobody goes to the sea cave without getting past me. Grandmother's rules!",
        "Fine. Go and listen to the bell. Don't say I didn't warn you." },
    [TR_WEST_OKE] = { "WARDEN OKE", 2, { SP_EMPERICE, SP_MEDUSHOCK }, { 27, 28 }, 1350,
        "The ferry brings one warden a week. Finally, it's my turn!",
        "Next week I'll be ready. Probably." },
    /* the CURRENT HALL (levels 23-26) */
    [TR_HALL_RILL] = { "WARDEN RILL", 2, { SP_PEBBOTTER, SP_BUBBLIN }, { 23, 24 }, 900,
        "You rode the current up here? Then you already know: it doesn't let go.",
        "Swept away. Totally swept away." },
    [TR_HALL_EDDY] = { "WARDEN EDDY", 3, { SP_JELLUME, SP_AXOLURK, SP_CRANICRAB }, { 24, 24, 25 }, 1050,
        "One channel goes up to MAREN. The other goes right back to the door. Guess!",
        "You guessed right. Or you beat me. Same thing." },
    [TR_HALL_WAVE] = { "WARDEN WAVE", 2, { SP_TUXFLAKE, SP_LURELING }, { 25, 26 }, 950,
        "Hiding in the nook? So was I!",
        "Cornered and beaten. In my own nook." },
    /* HALL MASTER MAREN: six TIDE kin (battle_start_master adds the banner) */
    [TR_MAREN] = { "MAREN", 6, { SP_CRANICRAB, SP_JELLUME, SP_LURELING, SP_TORRENTTER, SP_MEDUSHOCK, SP_AXOLURK },
        { 25, 25, 26, 27, 27, 28 }, 3000, "",
        "The tide turns for everyone. Today it turned for you. The TIDE CREST is yours!" },
    [TR_FEN_TEASER] = { "WARDEN MO", 2, { SP_PEBBOTTER, SP_WEBBIT }, { 18, 18 }, 790,
