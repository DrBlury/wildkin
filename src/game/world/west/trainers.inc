/* world/west/trainers.inc -- Wardens: [TR_X] = { "WARDEN X", count, { species... }, { levels... }, prize, "intro", "lose" },. Owner: W-WEST. */
    /* SALTWIND TRAIL (levels 15-19) */
    [TR_WEST_NILS] = { "WARDEN NILS", 2, { SP_PEBBOTTER, SP_PUFFOWL }, { 15, 16 }, 640,
        "The trail to PORT BRINE? Sure. Toll's one bout!",
        "Toll paid. In full. Go on." },
    [TR_WEST_PERLA] = { "WARDEN PERLA", 3, { SP_CRANICRAB, SP_PARASOLE, SP_BUBBLIN }, { 15, 15, 16 }, 700,
        "Salt in the air, sand in my boots, and a bout on the way. Perfect day!",
