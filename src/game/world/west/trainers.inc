    [TR_FEN_BIRDER] = { "WARDEN IBIS", 2, { SP_PUFFOWL, SP_HUMBEE }, { 19, 20 }, 950,
        "Hear the herons above us?", "They saw that coming." },
    [TR_FEN_REED_A] = { "WARDEN REE", 2, { SP_MOSSHELL, SP_SHROOMLET }, { 19, 20 }, 1000,
