    [TR_FEN_REED_B] = { "WARDEN DEE", 2, { SP_WEBBIT, SP_BLINKET }, { 20, 21 }, 1000,
        "Ree and I work in pairs!", "The reeds will grow back." },
    [TR_FEN_FISHER] = { "WARDEN FIN", 3, { SP_BUBBLIN, SP_PEBBOTTER, SP_JELLUME }, { 20, 21, 22 }, 1100,
