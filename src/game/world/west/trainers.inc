    [TR_REED_BOAT] = { "WARDEN KEEL", 2, { SP_PEBBOTTER, SP_BUBBLIN }, { 20, 21 }, 990,
        "A good boat rides any current.", "The bow needs mending." },
    [TR_REED_SMOKER] = { "WARDEN ASH", 2, { SP_MOSSHELL, SP_JELLUME }, { 20, 21 }, 990,
