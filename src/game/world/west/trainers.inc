    [TR_WEST_SKIM] = { "WARDEN SKIM", 3, { SP_JELLUME, SP_PEBBOTTER, SP_BUBBLIN }, { 23, 23, 24 }, 1150,
        "Swam all the way out here to train. Where's YOUR towel?",
