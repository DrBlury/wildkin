/* world/farm/lore.inc -- Lorebook entries: [LORE_X] = { LCH_..., LSRC_..., "TITLE", "page", "talk" },. Owner: FARM system. */
    [LORE_WILLOW_ACRE] = { LCH_FARMING, LSRC_REEVE, "WILLOW ACRE",
        "WILLOW ACRE lies just south of Maple Village. The old Kinship farmed it for two hundred years; "
        "the willows along its pond were planted by the first wardens to hold the bank together.\n\n"
        "The deed comes with the farmhouse, a HOE, a WATERING CAN and a few seeds. The rest is up to you.\n\n"
        "REAL SCIENCE: willow roots bind wet soil so well that people still plant them to stop banks washing away.",
        "That plot has been empty since old Tam moved to the coast. Good soil. Somebody should love it again." },
    [LORE_SOIL_WATER] = { LCH_FARMING, LSRC_REEVE, "SOIL AND WATER",
        "Till the soil with the HOE so roots can breathe, then water it. A crop only grows on a day it started "
        "wet. Rain waters every plot for you, and a SPRINKLER waters the eight around it each morning.\n\n"
        "REAL SCIENCE: roots take up water carrying dissolved minerals; a plant that runs dry closes its leaf "
        "pores and stops growing until it drinks again.",
        "Water in the morning, harvest in the sun. Roots do their drinking at night." },
    [LORE_SHIPPING] = { LCH_FARMING, LSRC_REEVE, "SELLING PRODUCE",
        "Put produce in the SHIPPING BIN and the carter pays you the next morning. Choose KEEP ONE EACH to hold "
        "back one of everything for cooking. Jam, pickles and dried goods from your PRESERVES JAR and DRYING RACK "
        "fetch far more than fresh crops.",
        "The carter comes at dawn. Honest as the sunrise, and about as punctual." },
    [LORE_FERTILISER] = { LCH_FARMING, LSRC_FARM_NOTES, "FERTILISER",
        "FERTILIZER makes a crop grow a little faster. RICH COMPOST makes GREAT and PERFECT harvests likelier, "
        "and those give extra. GROW MULCH keeps watered soil damp for a second day.\n\n"
        "REAL SCIENCE: plants build themselves mostly from air and water, but need nitrogen, phosphorus and "
        "potassium from the soil. Compost returns them; mulch slows evaporation.",
        0 },
    [LORE_FARMHANDS] = { LCH_FARMING, LSRC_FARM_NOTES, "KIN FARMHANDS",
        "The WORK BOARD in the farmhouse gives up to four kin from your Shelf a job. They work each morning: "
        "TIDE kin water, BLOOM kin tend, BEAST and BRAWL kin harvest, RELIC and DUSK kin keep the crows off, "
        "SWARM kin fetch honey, and any kin can forage. Working builds bond and a little experience.\n\n"
        "VALE ONLY: a kin's field pumps a little warmth into the soil it sleeps on.",
        0 },
    [LORE_FRUIT_TREES] = { LCH_FARMING, LSRC_FARM_NOTES, "FRUIT TREES",
        "Saplings go straight into the orchard mounds, no tilling needed. They take twelve days to grow and need "
        "no watering, then fruit every three days for good.\n\n"
        "REAL SCIENCE: fruit trees are perennials; their deep roots find water long after the topsoil dries.",
        0 },
    [LORE_DAY_NIGHT] = { LCH_WEATHER, LSRC_FARM_NOTES, "DAY AND NIGHT",
        "A day in the Vale passes in twenty-four minutes of walking about. Night falls at eight and lasts until "
        "six; some kin only come out after dark, others only by day. Sleep in any bed to skip to morning.\n\n"
        "REAL SCIENCE: day and night come from the world turning; the reds of dusk are sunlight scattered "
        "through more air near the horizon.",
        0 },
