/* world/north/lore.inc -- Lorebook entries: [LORE_X] = { LCH_..., LSRC_..., "TITLE", "page", "talk" },. Owner: W-NORTH. */

    [LORE_FROSTPINE] = { LCH_PLACES, LSRC_YAK_HERDER, "FROSTPINE PASS",
        "North of Stormstone Rise the road climbs into the Frostpine Pass: snowy pines, "
        "drifts of frosted grass, a frozen pond and an icy stream that never quite stops "
        "flowing.\n\n"
        "FLURRABBIT and TUXFLAKE nest in the drifts. YAKLING calves graze the frosted "
        "grass under the snow, and RAMBLET butt heads with anything that stands still, "
        "including trees. On clear nights MOONHARE come down from the peak.\n\n"
        "The herders of Frosthollow bring their yaks down the pass every spring and back "
        "up every autumn. A yak's thick coat traps still air, and still air is one of the "
        "best insulators there is.\n\n"
        "REAL SCIENCE: fur and down keep animals warm by trapping air, not by making heat.",
        "Cold today? This is a warm day for the pass. Sit by my fire a moment.\f"
        "I'll tell you who lives up here. Mind the calves." },

    [LORE_FROSTHOLLOW] = { LCH_PLACES, LSRC_FROST_ELDER, "FROSTHOLLOW",
        "Frosthollow sits in a high valley under Whitecrown Peak, where the snow lies "
        "eight months of the year. Its log houses have steep roofs so the snow slides "
        "off, and every chimney smokes from autumn to spring.\n\n"
        "The town grew around a Hearth Hall. Up here a hearth is not a comfort, it is "
        "survival: kin and people alike gathered around the warm stone, and FROST kin "
        "learned that they could shed their surplus into the cold air without harming "
        "anyone.\n\n"
        "The RIME HALL is the pride of the town. Its Master teaches the one lesson the "
        "mountain teaches everyone: on ice, you choose where you start, and the world "
        "chooses where you stop.\n\n"
        "East of the plaza a cave mouth leads into the GLIMMER CAVERNS. The steam over "
        "the rooftops comes from the hot spring behind the bathhouse.",
        "Welcome to Frosthollow, young warden. Stamp the snow off your boots.\f"
        "Let an old man tell you how this town came to be." },

    [LORE_GLIMMER] = { LCH_PLACES, LSRC_GLIMMER_MINER, "GLIMMER CAVERNS",
        "The Glimmer Caverns run under the mountain east of Frosthollow. Their walls are "
        "veined with glimmer crystal, which drinks light by day and glows softly all "
        "night, so the deep galleries are never completely dark.\n\n"
        "Some real minerals do this. Their crystals hold electrons in tiny traps; heat "
        "slowly shakes them loose, and each one gives off a little light as it falls "
        "back. The glow can last for hours.\n\n"
        "DIGGET dig in the soft floors, QUARTZLING graze on the crystal, and SQUEAKLE "
        "hang from the roof. Deeper down the caves are darker, and wardens say a violet "
        "light leaks from a crack into a grotto where the stars fall.\n\n"
        "REAL SCIENCE: persistent luminescence (glow-in-the-dark minerals).\n"
        "VALE ONLY: glimmer crystal.",
        "You want the caves? Then you want the truth about the crystals first.\f"
        "They're not magic. They're patient. Listen." },

    [LORE_HOT_SPRINGS] = { LCH_PLACES, LSRC_SPRING_SOAK, "THE HOT SPRING",
        "Behind the bathhouse in Frosthollow, water as warm as a bath bubbles out of the "
        "rock all year, even when the lake freezes solid.\n\n"
        "Rain and snowmelt seep down through cracks in the mountain, deep enough that the "
        "rock around them is hot. The warmed water rises again, carrying dissolved "
        "minerals, which is why the spring smells faintly of stone.\n\n"
        "The townsfolk soak after long days in the snow, and their kin soak beside them. "
        "FROST kin sit on the rim with only their feet in. Everyone agrees this is "
        "funny, except the FROST kin.\n\n"
        "REAL SCIENCE: the Earth gets warmer with depth; hot springs are groundwater "
        "heated by deep rock.",
        "Oh, you're still here? Get in, get in. No? Suit yourself.\f"
        "Did you ever wonder why it's warm? I did. For forty years." },

    [LORE_RIME_HALL] = { LCH_HALLS, LSRC_RIME_GUIDE, "THE RIME HALL",
        "The Rime Hall of Frosthollow is the Hall of FROST kin. Its floor is a sheet of "
        "polished ice scattered with frozen boulders, and one loose block of pumice light enough to push. "
        "Once you push off, you slide until "
        "something stops you: a rock, a wall, a warden, or dry stone.\n\n"
        "Why is ice so slippery? The surface of ice is never quite solid. Even far below "
        "freezing, the top few layers of molecules are loose and wobbly, almost liquid, "
        "and a sliding boot also warms the ice by friction. A thin wet film forms and "
        "your feet ride on it.\n\n"
        "The trick of the Hall is to plan backwards: find where you want to stop, then "
        "find the rock that will stop you there. If there is none, make one.\n\n"
        "REAL SCIENCE: the premelted surface layer of ice.",
        "The Hall is simple. You slide until you hit something.\f"
        "The hard part is choosing what you hit. Here is why the ice works that way." },

    [LORE_RIME_CREST] = { LCH_HALLS, LSRC_STORY, "THE RIME CREST",
        "You beat Hall Master SIGRUN of the Rime Hall and earned the RIME CREST, a disc "
        "of clear ice-blue glass that never fogs.\n\n"
        "With it, a strong GALE kin that flies will carry you to any town you have "
        "visited, and higher still: above the clouds over Whitecrown Peak floats the SKY "
        "ISLE, which no path reaches.\n\n"
        "Sigrun's words: cold, clear and certain. Know where you want to go, and the "
        "wind will take you there.",
        0 },

    [LORE_HOARFANG] = { LCH_LEGENDS, LSRC_SUMMIT_MONK, "HOARFANG",
        "HOARFANG, the winter wolf, is a FROST and DUSK legend whose kernel is older than "
        "Frosthollow. It lives on the summit of Whitecrown Peak.\n\n"
        "The monks say that when HOARFANG brims, it does not spill a storm like DRAKORA. "
        "It spills cold. It drinks the heat out of the air, and the long winter nights "
        "grow longer. Once, a century ago, the pass stayed frozen through a whole summer.\n\n"
        "Wardens climbed the Crown that year and answered it in a bout, and spring came "
        "back in a single week. Since then a corridor to the summit has been sealed by a "
        "boulder, so that only a warden with a kin of great STRENGTH can reach the wolf.\n\n"
        "The stone wolves on the summit face the same way it howls.",
        "You want to know what waits at the top? Then sit. This takes a while.\f"
        "Frosthollow remembers the summer that never came." },

    [LORE_SELENOTH] = { LCH_LEGENDS, LSRC_GROTTO_SCHOLAR, "SELENOTH",
        "SELENOTH is an ASTRAL and DREAM legend, a great pale moth whose wings are dusted "
        "with scales that glow like moonlight.\n\n"
        "It rests in the Starfall Grotto, below the Glimmer Caverns, where a hole in the "
        "roof lets the moon shine down onto a still pool. Its kernel pumps on cosmic-ray "
        "muons, which pass through the whole mountain, so even underground it never goes "
        "hungry. It only has to wait, and it is very good at waiting.\n\n"
        "People who sleep near the grotto dream of flying. Dr. Maren says the moth's "
        "field touches the faint bioelectric hum of a sleeping mind, the way DREAM kin "
        "do, and simply shares what it is doing.\n\n"
        "REAL SCIENCE: muons from cosmic rays reach deep underground.",
        "Shh. Speak softly here. It's resting.\f"
        "You came all this way. You should know who you're whispering around." },

    [LORE_SKYLORN] = { LCH_LEGENDS, LSRC_STARGAZER, "SKYLORN",
        "Above the sea of clouds over Whitecrown Peak floats the SKY ISLE, a slab of "
        "rock and snow that no path reaches. Its guardian is SKYLORN, a GALE and ASTRAL "
        "legend shaped like a vast manta that glides on the high winds.\n\n"
        "Stargazer Ida has watched it for years through her telescope: a dark shape that "
        "crosses the stars and never flaps. It rides rising air like a hawk, and its "
        "kernel drinks the cosmic rays that are strongest high above the ground.\n\n"
        "Nobody has walked to the Sky Isle. Only a warden who holds the RIME CREST and "
        "travels with a strong flying kin could reach it.",
        "Look, there! No... gone again. It's up there, I promise you.\f"
        "Let me tell you what I've seen through this lens." },

    [LORE_AURORA] = { LCH_WEATHER, LSRC_STARGAZER, "THE NORTHERN LIGHTS",
        "On winter nights curtains of green and violet light ripple over Whitecrown "
        "Peak. The townsfolk call them the Wolf's Breath.\n\n"
        "They are made far above the clouds. The sun blows out a steady wind of charged "
        "particles. The world's magnetic field steers some of them toward the poles, "
        "where they crash into the thin upper air. Oxygen struck this way glows green, "
        "higher up red, and nitrogen violet and blue.\n\n"
        "Frosthollow's aurora stones are carved with the old shapes of the lights. The "
        "runes glow when a FROST kin passes, which the stargazer says is only rime "
        "catching lamplight. The children say otherwise.\n\n"
        "REAL SCIENCE: the aurora.",
        "Did you see the lights last night? No? Then you'll want the explanation twice.\f"
        "Here it is anyway." },

    [LORE_SNOWFLAKES] = { LCH_WEATHER, LSRC_ICE_CARVER, "SNOWFLAKES",
        "Every snowflake grows around a speck of dust, one water molecule at a time, as "
        "it tumbles down through the cloud. Water molecules fit together in rings of six, "
        "so every flake has six arms.\n\n"
        "The shape depends on the air it falls through. Just below freezing it grows flat "
        "plates. A little colder and it grows needles. Colder still, plates again, and in "
        "damp air those plates sprout branching arms. Two flakes are alike only if they "
        "fell through exactly the same air.\n\n"
        "The ice carver says a kin's kernel grows the same way: layer by layer, its "
        "shape decided by what it lived through.\n\n"
        "REAL SCIENCE: snow crystal growth (the Nakaya diagram).",
        "Look at this one. Six arms. Always six.\f"
        "Do you know why? Nobody asks why. Sit down." },

    [LORE_WINTER_COATS] = { LCH_BIOLOGY, LSRC_FROST_TENDER, "WINTER COATS",
        "Kin that live in the snow keep warm the same ways real animals do.\n\n"
        "Thick fur and down trap still air. Penguins and yaks bring cold blood back from "
        "their feet past the warm blood going out, so heat stays in the body instead of "
        "leaking into the ice. Some animals burn a special brown fat just to make heat.\n\n"
        "FROST kin are the odd ones out. Their kernels pump by shedding heat as light, so "
        "the colder the air, the better they feel. A FROST kin in a warm room is like "
        "you in a sauna in a fur coat.\n\n"
        "REAL SCIENCE: insulation, countercurrent heat exchange and brown fat.\n"
        "VALE ONLY: kernels that cool by shedding light (built on real laser cooling).",
        "Rest your kin by the fire. Well, most of them. Keep the FROST ones by the door.\f"
        "I'll tell you why." },

    [LORE_FROST_GOODS] = { LCH_PLACES, LSRC_FROST_CLERK, "THE FROST SHOP",
        "The Frost Shop sells what mountain wardens need: strong tonics, STAR LANTERNS "
        "for fast wild kin, WAYSTONES for getting home, and shards of FROST and ASTRAL "
        "crystal traded down from the peak.\n\n"
        "Everything up here is carried on yak-back through the pass, which is why the "
        "clerk counts every coin twice and every tonic three times.\n\n"
        "ASTRAL SHARDS are found where meteorites fell. A FLURRABBIT that touches one "
        "grows into a MOONHARE.",
        "Business is slow in the snow. Want to hear about the stock? It's riveting.\f"
        "Well, it's warm in here, at least." },
    [LORE_STORMSTEP] = { LCH_PLACES, LSRC_STORMSTEP, "STORMSTEP FOOTHILLS",
        "The storm broke a shelf of stone above the Rise. Past the rockfall, basalt steps wind through meadow to the first alpine snow. The storm shrine marks the old safe trail.",
        "Stone remembers the thunderclap. Follow the basalt steps and watch the ledges." },
    [LORE_STORM_CALM] = { LCH_WEATHER, LSRC_STORM_WATCHER, "AFTER THE STORM",
        "The storm above Drakora's shrine has calmed, but wind still lifts moisture up the mountain. High air cools; cloud and snow form on the scree above the meadow.",
        "The sky is quiet now. Rising air still carries snow over the high trail." },
    [LORE_TIMBERLINE] = { LCH_PLACES, LSRC_TIMBER_ASTRID, "TIMBERLINE",
        "The logging hamlet stands where the last pines meet the snow. Logs run down the flume to the mill; a warm lodge keeps kin and travellers safe overnight.",
        "The lodge stays warm for every traveller. FROST kin cool the air around them by shedding heat." },
    [LORE_TIMBER_AURORA] = { LCH_WEATHER, LSRC_TIMBER_AURORA, "TIMBER AURORA",
        "Clear winter nights reveal curtains of aurora above the mill. Charged particles excite the thin high air; its light ripples across the snow.",
        "On the coldest clear nights the sky glows above the mill." },
