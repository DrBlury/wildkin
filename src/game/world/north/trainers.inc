/* world/north/trainers.inc -- Wardens: [TR_X] = { "WARDEN X", count, { species... }, { levels... }, prize, "intro", "lose" },. Owner: W-NORTH.
 * Levels: Foothills 29-32, Frostpine 31-34, Glimmer 31-35, Master 34-37. */
    /* ---- Frostpine Pass ---- */
    [TR_N_BRYN] = { "WARDEN BRYN", 1, { SP_FLURRABBIT }, { 31 }, 1050,
                    "Up from the Rise, are you? Your kin will want to warm up. A bout does that!",
                    "Whew! I'm toasty now. Thanks for that." },
    [TR_N_ODA] = { "WARDEN ODA", 1, { SP_YAKLING }, { 31 }, 1320,
                   "The bridge is mine to watch. Nobody crosses without a bout. Village rules!",
                   "Cross, cross! You earned the bridge." },
    [TR_N_TOVE] = { "WARDEN TOVE", 1, { SP_TUXFLAKE }, { 33 }, 1440,
                    "Frosthollow is just ahead. Show me you can handle the cold first!",
                    "You'll do fine up there. Say hi to the Hall Master for me." },
    /* ---- Whitecrown Peak ---- */
    [TR_N_ASKEL] = { "WARDEN ASKEL", 4, { SP_CRAGHORN, SP_GLACIYAK, SP_EMPERICE, SP_GOLEMIT }, { 30, 30, 31, 31 }, 1860,
                     "The air's thin up here. Thin air, short tempers. Bout!",
                     "My head's spinning. Altitude. Definitely the altitude." },
    [TR_N_RUNA] = { "WARDEN RUNA", 5, { SP_FLURRABBIT, SP_MOONHARE, SP_RAMBLET, SP_CRAGHORN, SP_GLACIBLOB },
                    { 30, 31, 31, 32, 32 }, 2240,
                    "Every warden who climbs the Crown meets me first. It's tradition!",
                    "Tradition upheld. Keep climbing, and listen for the wolf." },
    [TR_N_EINAR] = { "WARDEN EINAR", 6, { SP_EMPERICE, SP_GLACIYAK, SP_CRAGHORN, SP_NOCTAVE, SP_GOLEMIT, SP_FROSTOAT },
                     { 32, 32, 33, 33, 33, 34 }, 2800,
                     "Six kin, sixty winters on this mountain. Let's see what you've got.",
                     "Sixty winters, and still learning. Go on up." },
    /* ---- Glimmer Caverns ---- */
    [TR_N_PELL] = { "WARDEN PELL", 3, { SP_DIGGET, SP_SQUEAKLE, SP_BLINKET }, { 31, 32, 33 }, 1200,
                    "Mind the dark! I can hardly see you. Luckily, my kin can.",
                    "Lights out for me. Well played." },
    [TR_N_NESSA] = { "WARDEN NESSA", 4, { SP_QUARTZLING, SP_BLINKET, SP_LURELING, SP_GOLEMIT }, { 31, 32, 33, 34 }, 1560,
                     "The crystals sing when kin bout near them. Let's make them sing!",
                     "Did you hear that chord? Beautiful." },
    [TR_N_ORRIN] = { "WARDEN ORRIN", 3, { SP_GOLEMIT, SP_DIGGET, SP_QUARTZLING }, { 31, 32, 33 }, 1350,
                     "I mine glimmer crystal. You look like you're mining for a bout.",
                     "You struck a rich vein there." },
    /* ---- Glimmer Depths ---- */
    [TR_N_VIGGO] = { "WARDEN VIGGO", 4, { SP_NOCTAVE, SP_QUARTZLING, SP_SQUEAKLE, SP_DIGGET }, { 31, 32, 33, 34 }, 1740,
                     "Down here the dark is total. My bats don't mind. Do you?",
                     "Echoes of defeat. Mine." },
    [TR_N_LIV] = { "WARDEN LIV", 5, { SP_BLINKET, SP_BEACONFLY, SP_LURELING, SP_QUARTZPEDE, SP_GLACIBLOB },
                   { 31, 32, 33, 34, 35 }, 2100,
                   "I followed the violet light down here. Want to see why it glows?",
                   "Go on, then. The grotto's through the crack. Be quiet in there." },
    [TR_N_SOREN] = { "WARDEN SOREN", 4, { SP_QUARTZPEDE, SP_NOCTAVE, SP_DIGGET, SP_METEORB }, { 31, 32, 33, 34 }, 1980,
                     "A fallen star made this cave, they say. My METEORB agrees.",
                     "Knocked flat like a shooting star." },
    /* ---- the Rime Hall ---- */
    [TR_N_ASTA] = { "WARDEN ASTA", 1, { SP_TUXFLAKE }, { 29 }, 1500,
                    "Welcome to the Rime Hall! First lesson: the ice decides where you stop.",
                    "Second lesson: plan every slide. Good luck!" },
    [TR_N_KJELL] = { "WARDEN KJELL", 1, { SP_GLACIBLOB }, { 30 }, 1860,
                     "You slid all the way out here? Then you can stand still for a bout!",
                     "I'll just... stay on my island a while." },
    [TR_N_FRIDA] = { "WARDEN FRIDA", 1, { SP_TUXFLAKE }, { 31 }, 1920,
                     "Most challengers never reach this island. Impressive!",
                     "You'd make a fine skater." },
    [TR_N_TORVALD] = { "WARDEN TORVALD", 2, { SP_FROSTOAT, SP_GLACIBLOB },
                       { 31, 33 }, 2400,
                       "You made it across! Only one bout stands between you and the Master: mine.",
                       "Go on. SIGRUN has been watching you since the door." },
    /* HALL MASTER SIGRUN: shown as "HALL MASTER SIGRUN" (TT_MASTER); started by scr_rime_master */
    [TR_N_SIGRUN] = { "SIGRUN", 6, { SP_FROSTOAT, SP_GLACIBLOB, SP_EMPERICE, SP_GLACIYAK, SP_MOONHARE, SP_WENDIGAUNT },
                      { 34, 34, 35, 35, 36, 37 }, 5200, "",
                      "Cold, clear and certain. That was a warden's bout. The RIME CREST is yours." },
    [TR_N_HIKER_1] = { "HIKER IVA", 1, { SP_RAMBLET }, { 29 }, 1600, "The first steps are the hardest!", "Keep climbing." },
    [TR_N_HIKER_2] = { "HIKER SOL", 1, { SP_TRUFFLOAR }, { 29 }, 1600, "The ridge has two paths. Take your pick!", "Both lead uphill." },
    [TR_N_GUIDE] = { "GUIDE ARO", 1, { SP_FLYSQUIRL }, { 30 }, 2050, "Watch your feet on the basalt steps.", "You found your footing." },
    [TR_N_CLIMBER_1] = { "CLIMBER BO", 2, { SP_CRAGHORN, SP_FROSTOAT }, { 31, 32 }, 1750, "We climb together!", "Good climb!" },
    [TR_N_CLIMBER_2] = { "CLIMBER ELI", 2, { SP_YAKLING, SP_STORMHAWK }, { 31, 32 }, 1750, "Two climbers, one trail!", "Well climbed." },
    [TR_N_WATCHER] = { "WATCHER ADA", 1, { SP_PUFFOWL }, { 30 }, 1900, "Clouds are gathering again.", "The storm remains calm." },
    [TR_N_SCREE] = { "SCREE GUARD", 1, { SP_FLURRABBIT }, { 32 }, 1950, "The cache is behind me!", "You earned it." },
    [TR_N_LOGGER_1] = { "LOGGER FINN", 1, { SP_GNAWLORD }, { 31 }, 1800, "Logs are heavy. Our kin are stronger!", "They need a rest." },
    [TR_N_LOGGER_2] = { "LOGGER SVEA", 1, { SP_RAMBLET }, { 31 }, 1750, "The mill never sleeps!", "I will." },
