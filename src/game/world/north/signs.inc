    { MAP_FROSTPINE, 13, 39, "FROSTPINE PASS\fSouth: TIMBERLINE. North: FROSTHOLLOW. Mind the frozen pond!" },
    { MAP_FROSTPINE, 21, 3, "FROSTHOLLOW ahead\fHearth Hall, Frost Shop and the RIME HALL." },
    { MAP_FROSTHOLLOW, 22, 37, "FROSTHOLLOW\fThe town where the hearths never go out." },
    { MAP_FROSTHOLLOW, 32, 7, "RIME HALL\fMaster SIGRUN. The ice decides where you stop." },
    { MAP_FROSTHOLLOW, 33, 16, "GLIMMER CAVERNS\fDark inside. Crystals, bats, and stairs going down." },
    { MAP_WHITECROWN, 21, 37, "WHITECROWN PEAK\fThe summit belongs to the winter wolf. Climb with respect." },
    { MAP_WHITECROWN, 10, 29, "Upper slopes\fLedges drop you back down. There is no shame in a second try." },
    { MAP_GLIMMER_1, 21, 21, "GLIMMER CAVERNS\fStairs down in the north-west gallery. Stay off the lake ice... it isn't ice." },
    { MAP_FOOTHILLS, 13, 57, "RIDGE CLOSED BY ROCKFALL\fWARDENS WITH THE ANVIL CREST MAY CLEAR IT. The last thunderclap brought the ridge down." },
    { MAP_FOOTHILLS, 15, 42, "STORMSTEP SHRINE\fDRAKORA's storm is calm. Beyond the ridge the snow begins." },
    { MAP_TIMBERLINE, 15, 30, "TIMBERLINE\fWarm lodge west, sawmill east. The north road leads to FROSTPINE." },
    { MAP_WHITECROWN, 20, 12, "The summit ice is sealed. Return after the Hollowing is answered." },
    { MAP_STORM_CAVE, 15, 3, "KARST FISSURE\fOnly ANVIL wardens may pass. STRENGTH shifts loose stones." },
    { MAP_KARST_CHAMBER, 7, 14, "KARST CHAMBER\fWest: Stormstep. North-east: sawmill cellar. South-east: Glimmer." },
    { MAP_KARST_FROST, 6, 12, "FROST SPUR\fPush the loose stone north twice. Slide east until it stops, then turn north.\fThe lower walk always leads home." },

