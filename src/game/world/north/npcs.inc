    WARDEN(MAP_FOOTHILLS, 16, 39, GUIDE, UP, 2, TR_N_GUIDE, SP_FLYSQUIRL, "Mind the loose stone."),
    WARDEN(MAP_FOOTHILLS, 13, 27, WARDEN_A, RIGHT, 2, TR_N_CLIMBER_1, SP_CRAGHORN, "Climbing with Eli today!"),
    WARDEN(MAP_FOOTHILLS, 24, 26, WARDEN_B, LEFT, 2, TR_N_CLIMBER_2, SP_YAKLING, "Climbing with Bo today!"),
    WARDEN(MAP_FOOTHILLS, 24, 13, WARDEN_A, LEFT, 3, TR_N_WATCHER, SP_STORMHAWK, "The winds changed after Drakora's storm."),
    PERSON(MAP_FOOTHILLS, 25, 11, ELDER, LEFT, STILL, TALK, LSRC_STORM_WATCHER, "STORM WATCHER",
           "The sky is calm, but the high air still brings snow."),
    WARDEN(MAP_FOOTHILLS, 30, 18, WARDEN_B, LEFT, 2, TR_N_SCREE, NO_KIN, "A scree cache? Earn it first."),
    PERSON(MAP_TIMBER_LODGE, 6, 3, HEALER, DOWN, STILL, TIMBER_TENDER, LSRC_TIMBER_ASTRID, "ASTRID", 0),
