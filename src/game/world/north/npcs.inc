/* world/north/npcs.inc -- People: PERSON(...), PERSON_KIN(...), WARDEN(...),. Owner: W-NORTH. */
    /* ---- Frostpine Pass ---- */
    PERSON_KIN(MAP_FROSTPINE, 30, 28, VILLAGER, LEFT, LOOK, TALK, LSRC_YAK_HERDER, SP_YAKLING, "YAK HERDER",
               "My YAKLING calves hate the stream. I carry them over the bridge one at a time. All eleven."),
    PERSON(MAP_FROSTPINE, 16, 29, KID, DOWN, WANDER, TALK, NO_LORE, "SKI KID",
           "Watch the frozen pond! Once you step on the ice, you slide until something stops you. Wheee!"),
    WARDEN(MAP_FROSTPINE, 9, 36, WARDEN_A, RIGHT, 3, TR_N_BRYN, SP_FLURRABBIT,
           "The pass gets colder every step. FLURRABBIT doesn't mind. It sheds heat for fun."),
    WARDEN(MAP_FROSTPINE, 21, 19, WARDEN_B, LEFT, 2, TR_N_ODA, SP_YAKLING, "The bridge is yours. Mind the ice on the planks."),
    WARDEN(MAP_FROSTPINE, 22, 7, WARDEN_A, LEFT, 2, TR_N_TOVE, NO_KIN, "FROSTHOLLOW has a HEARTH HALL. Warm up there."),
    /* ---- Frosthollow ---- */
    PERSON(MAP_FROSTHOLLOW, 22, 12, ELDER, DOWN, LOOK, TALK, LSRC_FROST_ELDER, "ELDER HALVARD",
           "Frosthollow keeps its hearths lit all winter. And winter here is most of the year."),
    PERSON(MAP_FROSTHOLLOW, 24, 15, HERMIT, DOWN, STILL, ICE_CARVER, LSRC_ICE_CARVER, "ICE CARVER", 0),
    PERSON(MAP_FROSTHOLLOW, 10, 35, KID_B, DOWN, WANDER, TALK, NO_LORE, "SKATER",
           "Try the pond! Push off and you slide until you bump into something. That's how the RIME HALL works too!"),
    PERSON(MAP_FROSTHOLLOW, 29, 7, GUIDE, LEFT, LOOK, RIME_GUIDE, LSRC_RIME_GUIDE, "HALL GUIDE", 0),
    PERSON(MAP_FROSTHOLLOW, 35, 18, FISHER, LEFT, LOOK, TALK, LSRC_GLIMMER_MINER, "OLD MINER",
           "The GLIMMER CAVERNS go deep. Take a light, or a kin that makes one."),
    PERSON_KIN(MAP_FROSTHOLLOW, 25, 32, VILLAGER, LEFT, WANDER, TALK, NO_LORE, SP_TUXFLAKE, "VILLAGER",
               "My TUXFLAKE follows me to the market every morning. It carries nothing and eats everything."),
    PERSON(MAP_FROSTHOLLOW, 10, 16, KID, DOWN, LOOK, TALK, NO_LORE, "KID",
           "The notice board says the HALL MASTER once slid across the whole lake without stopping. Twice!"),
    /* ---- interiors ---- */
    PERSON(MAP_FROST_HEARTH, 5, 2, HEALER, DOWN, STILL, FROST_TENDER, LSRC_FROST_TENDER, "TENDER EIR", 0),
    PERSON(MAP_FROST_HEARTH, 2, 5, WARDEN_B, RIGHT, LOOK, TALK, NO_LORE, "RESTING WARDEN",
           "I tried the RIME HALL three times. Tip: before you slide, look where the rocks are. All of them."),
    PERSON(MAP_FROST_SHOP, 1, 2, SHOPKEEPER, DOWN, STILL, FROST_SHOP, LSRC_FROST_CLERK, "CLERK", 0),
    PERSON(MAP_FROST_HOUSE, 6, 4, GRAN, DOWN, LOOK, ALDER_GRAN, NO_LORE, "GRANNY ALDER", 0),
    PERSON(MAP_FROST_HOUSE, 2, 7, KID, UP, WANDER, TALK, NO_LORE, "KID",
           "Granny says HOARFANG howls on the longest night, and the snow listens. I stay up every year. I never hear it."),
    PERSON(MAP_STARGAZER, 7, 4, SCIENTIST, DOWN, LOOK, STARGAZER, LSRC_STARGAZER, "STARGAZER IDA", 0),
    PERSON(MAP_HOT_SPRING, 10, 4, BAKER, LEFT, LOOK, CHEF, NO_LORE, "SPRING COOK", 0),
    PERSON(MAP_HOT_SPRING, 2, 3, ELDER, RIGHT, STILL, TALK, LSRC_SPRING_SOAK, "OLD SOAK",
           "Ahhh. Forty winters I've soaked here. Every one of them was worth it."),
    PERSON(MAP_HOT_SPRING, 6, 7, HEALER, UP, LOOK, SPRING_KEEPER, NO_LORE, "SPRING KEEPER", 0),
    /* ---- the Rime Hall ---- */
    WARDEN(MAP_RIME_HALL, 10, 17, WARDEN_A, LEFT, 4, TR_N_ASTA, SP_TUXFLAKE, "Plan every slide!"),
    WARDEN(MAP_RIME_HALL, 3, 8, WARDEN_B, RIGHT, 3, TR_N_KJELL, NO_KIN, "My island. My rules. You won anyway."),
    WARDEN(MAP_RIME_HALL, 12, 13, WARDEN_A, LEFT, 3, TR_N_FRIDA, NO_KIN, "Few reach this island. Fewer leave it gracefully."),
    WARDEN(MAP_RIME_HALL, 13, 2, WARDEN_B, DOWN, 1, TR_N_TORVALD, NO_KIN, "The Master is waiting."),
    PERSON(MAP_RIME_HALL, 7, 2, ELDER, DOWN, STILL, RIME_MASTER, NO_LORE, "MASTER SIGRUN", 0),
    /* ---- Whitecrown Peak ---- */
    WARDEN(MAP_WHITECROWN, 14, 32, WARDEN_A, UP, 2, TR_N_ASKEL, SP_CRAGHORN, "Catch your breath. Then climb."),
    WARDEN(MAP_WHITECROWN, 22, 20, WARDEN_B, DOWN, 1, TR_N_RUNA, NO_KIN, "Listen for the wolf. You'll know it when you hear it."),
    WARDEN(MAP_WHITECROWN, 26, 13, WARDEN_A, LEFT, 2, TR_N_EINAR, SP_GLACIYAK, "The summit is past the old corridor. Bring strength."),
    PERSON(MAP_WHITECROWN, 21, 13, HERMIT, RIGHT, STILL, TALK, LSRC_SUMMIT_MONK, "SUMMIT MONK",
           "A boulder sealed the corridor to the summit long ago. Only a kin of great STRENGTH could move it."),
    /* ---- Glimmer Caverns ---- */
    PERSON(MAP_GLIMMER_1, 33, 6, FISHER, LEFT, LOOK, TALK, NO_LORE, "CRYSTAL MINER",
           "Glimmer crystal drinks light all day and gives it back all night. Don't take any. It'd go dark in your pocket."),
    WARDEN(MAP_GLIMMER_1, 12, 16, WARDEN_A, DOWN, 3, TR_N_PELL, SP_BLINKET, "BLINKET's light is all I need down here."),
    WARDEN(MAP_GLIMMER_1, 24, 18, WARDEN_B, LEFT, 4, TR_N_NESSA, NO_KIN, "Listen. The crystals are still ringing."),
    WARDEN(MAP_GLIMMER_1, 7, 10, WARDEN_A, RIGHT, 3, TR_N_ORRIN, SP_DIGGET, "The stairs down are just behind me."),
    WARDEN(MAP_GLIMMER_2, 6, 15, WARDEN_B, DOWN, 3, TR_N_VIGGO, SP_NOCTAVE, "The dark is friendlier than it looks."),
    WARDEN(MAP_GLIMMER_2, 20, 9, WARDEN_A, LEFT, 3, TR_N_LIV, NO_KIN, "Follow the violet light."),
    WARDEN(MAP_GLIMMER_2, 28, 20, WARDEN_B, UP, 3, TR_N_SOREN, SP_METEORB, "Look up in the grotto. You'll see why it's called Starfall."),
    /* ---- Starfall Grotto ---- */
    PERSON(MAP_STARFALL, 17, 16, SCIENTIST, LEFT, LOOK, GROTTO_SCHOLAR, LSRC_GROTTO_SCHOLAR, "DR. MAREN", 0),
