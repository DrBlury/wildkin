/* world/grim/signs.inc -- Signs: { MAP_X, x, y, "text" },. Owner: W-GRIM. */
    { MAP_ASHEN_FIELDS, 19, 3, "ASHEN FIELDS\fThe Ashen March begins here. Keep to the road; the ash is deeper than it looks." },
    { MAP_ASHEN_FIELDS, 40, 18, "EAST: GRAVEWOOD\fThen DUSKMERE, on the mire. Lanterns lit day and night." },
    { MAP_GRAVEWOOD, 3, 19, "GRAVEWOOD\fThe old oaks died in the Burning and never fell. Please do not disturb the graves." },
    { MAP_GRAVEWOOD, 41, 18, "EAST: DUSKMERE\fMind the black water. It is deeper than the reeds." },
    { MAP_DUSKMERE, 8, 19, "DUSKMERE\fThe town that kept its lanterns lit through the Burning." },
    { MAP_DUSKMERE, 31, 8, "THE LANTERN CRYPT\fHALL MASTER MORWEN. Bring your own light; the walls will not help you." },
    { MAP_DUSKMERE, 31, 18, "THE OSSUARY\fSealed by the Wardens' Accord. The gate opens for holders of all six crests." },
    { MAP_LANTERN_CRYPT, 10, 18, "The plaque reads:\fIN THE DARK, THE WALLS LIE. WHAT LOOKS OPEN MAY BE CLOSED, AND WHAT LOOKS CLOSED MAY OPEN." },
