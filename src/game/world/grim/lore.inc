/* world/grim/lore.inc -- Lorebook entries: [LORE_X] = { LCH_..., LSRC_..., "TITLE", "page", "talk" },. Owner: W-GRIM. */

    [LORE_HOLLOWING] = { LCH_HOLLOWING, LSRC_STORY, "THE HOLLOWING",
        "With DRAKORA answered, Keeper Linden turned the Almanac to an older page: "
        "the Ashen March, east of Copperline Road.\n\n"
        "A hundred years ago OSSUREX, the bone dragon, brimmed there. Nobody "
        "answered it. Its surplus came out as heat, and the March burned for a "
        "whole summer. Afterwards the land was grey, and the kernels of kin that "
        "died in the fire lay scattered through the ash.\n\n"
        "Now those old kernels are waking. They cannot find living bodies, so "
        "they build new ones out of bone and peat. People call it the Hollowing.\n\n"
        "The Keeper asks you to earn the six Hall crests. Under the Wardens' "
        "Accord only a holder of all six may pass the gate of the Ossuary in "
        "DUSKMERE, where OSSUREX sleeps on the BONE THRONE.",
        0 },

    [LORE_ASHEN_MARCH] = { LCH_PLACES, LSRC_SURVEYOR, "THE ASHEN MARCH",
        "South of Copperline Road the green stops. The ASHEN FIELDS were farms "
        "once: you can still find cart wheels, fence posts and a hundred years of "
        "ash on top of them.\n\n"
        "East of the fields lies GRAVEWOOD, an oak forest that died standing up, "
        "and beyond it DUSKMERE, a town on stilts over black peat water.\n\n"
        "The ash is not dead soil. It is rich in phosphorus and potash, the very "
        "things farmers spread on their fields, and it holds water well. What it "
        "lacks is rain. Bouts make rain, and nobody has bouted here for a century.\n\n"
        "REAL SCIENCE: volcanic and wildfire ash is famously fertile. Some of the "
        "richest farmland on Earth sits on old ash.\n\n"
        "VALE ONLY: a legend's surplus burning a whole region in one summer.",
        "Careful where you step, warden. I'm surveying for the Almanac: depth of "
        "the ash, what grows, what walks.\f"
        "It's worse than a desert and better than it looks. Here, let me show "
        "you the lay of it." },

    [LORE_THE_BURNING] = { LCH_HOLLOWING, LSRC_SURVEYOR, "THE BURNING",
        "The Almanac's page for that year is short. \"Spring: OSSUREX restless. "
        "Summer: the March is burning. Autumn: rain at last. Winter: no harvest.\"\n\n"
        "OSSUREX is a WYRM and a HOLLOW kin: an ancient kernel wearing a skeleton "
        "for a body. A kernel that big holds a staggering amount of energy. When "
        "it brimmed, the surplus left as heat for weeks. Grass dried, then "
        "smouldered, then the oaks caught.\n\n"
        "The people of DUSKMERE survived because their town stands on water. They "
        "rang the mire bell every night so the farm folk could find their way in "
        "through the smoke, and they have kept a lantern on every corner ever "
        "since.\n\n"
        "When the fire died, OSSUREX crawled into the Ossuary under DUSKMERE and "
        "has slept there since. Sleeping is not the same as answered.",
        "The worst of it? The Almanac says OSSUREX wasn't angry. It was full. "
        "Nobody gave it a bout.\f"
        "That's all it would have taken. One warden." },

    [LORE_PUMPKIN_LIGHTS] = { LCH_HOLLOWING, LSRC_ASHFARMER, "PUMPKIN LIGHTS",
        "Pumpkins are the first crop to take in the ash. Their big leaves shade "
        "the soil, their roots go deep, and they are not fussy.\n\n"
        "The March folk carve faces into them and set a light inside. It began "
        "as a way to scare crows. Then people noticed that HOLLOW kin, waking "
        "confused in the dark, walk towards the lights, calm down, and stay "
        "near the farms instead of wandering into the mire.\n\n"
        "PUMPKLING grow in those patches. Some of them grow into JACKOGRIM, a "
        "vine body with a lantern head, and nobody is quite sure which came "
        "first: the kin or the custom.\n\n"
        "REAL SCIENCE: squash and pumpkin are classic pioneer crops, and carved "
        "lanterns are a real harvest tradition.\n\n"
        "VALE ONLY: kin that follow a candle home.",
        "You like my patch? First green thing in these fields for a hundred "
        "years.\f"
        "Every pumpkin gets a face and a light. Let me tell you why." },

    [LORE_TYPE_HOLLOW] = { LCH_TYPES, LSRC_SEXTON, "HOLLOW KIN",
        "When a kin's body is gone, its kernel can outlive it by centuries. But "
        "a kernel needs energy to pump, and a buried kernel has only one source "
        "left: the slow heat of the ground itself.\n\n"
        "Rock and old bone hold tiny amounts of uranium, thorium and potassium. "
        "As those atoms decay they give off a trickle of heat. It is a very weak "
        "pump band, but it never runs out.\n\n"
        "With that trickle, a HOLLOW kernel precipitates a new body from whatever "
        "is at hand: bone (the mineral apatite), grave dust, peat. CALCIPUP, "
        "OSSIHOUND and RATTLEBONE wear skeletons; MUDDLE and BOGSHAMBLE wear the "
        "bog.\n\n"
        "HOLLOW kin strike DREAM and BLOOM kin hard, shrug off VENOM, and fear "
        "fire, carrion beetles (SWARM), talismans (RELIC) and starlight "
        "(ASTRAL).\n\n"
        "REAL SCIENCE: radiogenic heat is real. It keeps the Earth's core warm.\n\n"
        "VALE ONLY: kernels that live on it.",
        "Sexton Hobb. I dig, and SEXTONE digs better.\f"
        "You look at the bones and see death. I see kin that refused to stop. "
        "Sit on that stone. I'll explain." },

    [LORE_GRAVEWOOD] = { LCH_PLACES, LSRC_MOURNER, "GRAVEWOOD",
        "Gravewood was an oak forest. The Burning killed every tree, but oak is "
        "hard and slow to rot, so they are still standing a century later: grey, "
        "leafless, full of owls.\n\n"
        "Under them the March folk buried the ones they lost. The graveyard is "
        "tended by Sexton Hobb, and his SEXTONE keeps the paths clear.\n\n"
        "Fungi live on the dead wood (SHROOMLET, MYCOLOSSUS). Spiders live on "
        "whatever lives on the fungi (WEBBIT, LACEWIDOW). And at night green "
        "foxfire glows on the stumps, which is only a fungus too, though it does "
        "not look like one.\n\n"
        "People come here to talk to the graves. The graves never answer, but "
        "sometimes an OSSIHOUND sits down next to you and listens.",
        "Oh. I thought you were my sister for a moment. She never comes out "
        "here.\f"
        "My husband's under that stone. It's a good wood to rest in. Let me "
        "tell you about it." },

    [LORE_BOG_BODIES] = { LCH_HOLLOWING, LSRC_APOTHECARY, "BOG BODIES",
        "Peat bogs keep things. The water is cold, acid and has almost no oxygen, "
        "so the microbes that rot things can't live in it. Wood, cloth and "
        "leather come out of a bog centuries later looking nearly new.\n\n"
        "In the Duskmere mire this matters twice. The kernels that fell into the "
        "black water during the Burning were kept perfectly, and when they woke "
        "they built their bodies from what surrounded them: peat, moss and mud. "
        "That is a MUDDLE. Give it long enough and it grows mushrooms and "
        "becomes a BOGSHAMBLE.\n\n"
        "Mother Henbane cuts dried peat for her fires and swears the smoke "
        "cures anything. It does not, but it smells nice.\n\n"
        "REAL SCIENCE: peat bogs really do preserve things for thousands of "
        "years.\n\n"
        "VALE ONLY: the kin that climb out of them.",
        "Peat, dear. Everything in this shop is peat, bone or foxfire, and all "
        "three came out of the mire.\f"
        "Sit. The kettle's on. I'll tell you what the bog keeps." },

    [LORE_DUSKMERE] = { LCH_PLACES, LSRC_BELLKEEPER, "DUSKMERE",
        "Duskmere stands on stilts over the black peat water at the east end of "
        "the Ashen March. Its houses are dark timber, its streets are boardwalks, "
        "and a lantern burns on every corner, day and night.\n\n"
        "The lanterns are a promise. During the Burning the town rang the mire "
        "bell every night and hung lights so that anyone lost in the smoke could "
        "find the water. The lights were never put out again.\n\n"
        "The town has a Hearth Hall, a shop, Mother Henbane's apothecary and the "
        "LANTERN CRYPT, where Hall Master Morwen keeps the LANTERN Hall in the "
        "dark on purpose.\n\n"
        "East of the square is the sealed gate of the Ossuary. Nobody in Duskmere "
        "goes near it, and everybody in Duskmere looks at it every day.",
        "That's the mire bell. It rang a hundred nights in a row, once.\f"
        "Nobody's rung it since. Sit a while. I'll tell you about my town." },

    [LORE_LANTERN_CRYPT] = { LCH_HALLS, LSRC_STORY, "THE LANTERN CRYPT",
        "The LANTERN Hall is a crypt, and a dark one. Hall Master Morwen keeps it "
        "that way: a warden who can only fight in daylight is no use to anyone "
        "in the Ashen March.\n\n"
        "In the dark, eyes are poor judges. Some of the crypt's walls are painted "
        "shadows that you can walk straight through. Some of its open doorways "
        "are glass-black stone. The only way through is to trust your feet.\n\n"
        "Morwen's sanctum is sealed by two gates, and their candle switches burn deep in the "
        "crypt's wings. Every candle lit seals a door behind you; the star pads on the floor "
        "know another way out.\n\n"
        "HOLLOW kin fill the crypt, because the old stone is warm with the slow "
        "heat they live on.\n\n"
        "Beat Morwen and she lights the crypt's last lamp for you: the LANTERN "
        "CREST. It is the fifth of the six crests the Wardens' Accord asks for "
        "at the Ossuary gate.",
        0 },

    [LORE_WARDENS_ACCORD] = { LCH_HOLLOWING, LSRC_GATEKEEPER, "THE WARDENS' ACCORD",
        "After the Burning the six Hall Masters of the Vale met in Duskmere and "
        "made an agreement: the Accord.\n\n"
        "OSSUREX would not be woken by anyone who could not answer it. A half "
        "bout with a brimming legend is worse than none; the surplus spills "
        "out all at once. So the Ossuary was sealed, and a gate warden was set "
        "to guard it, and the gate opens only for a warden who carries all six "
        "crests: VOLT, TIDE, ANVIL, RIME, LANTERN and DREAM.\n\n"
        "The Accord has been kept for a hundred years. Every gate warden has "
        "been from the same family, and every one of them has hoped to be the "
        "one who opens it.",
        "You want to know why the gate is shut? Good question. Most folk just "
        "rattle it.\f"
        "My great-great-grandmother swore an oath at this gate. Here's what she "
        "swore." },

    [LORE_VIGIL] = { LCH_HOLLOWING, LSRC_VIGIL, "THE LAST VIGIL",
        "Someone has always sat with OSSUREX. The Vigil began the week the fire "
        "died: one Duskmere elder at a time, sitting at the foot of the Bone "
        "Throne with a lantern, so the great kernel would never wake alone.\n\n"
        "A sleeping legend is not a calm one. OSSUREX has been brimming, slowly, "
        "for a hundred years, and the Hollowing out in the March is its surplus "
        "leaking into the old kernels in the ash.\n\n"
        "The last Vigil keeper is very old. She has been waiting for a warden "
        "with six crests so she can finally go home.",
        "Six crests. Oh, you have six crests.\f"
        "I've sat here forty years, warden. Let me tell you what I've been "
        "watching over, before you wake it." },

    [LORE_OSSUREX] = { LCH_LEGENDS, LSRC_STORY, "OSSUREX",
        "OSSUREX, the bone dragon, is a WYRM and a HOLLOW kin. Its kernel is older "
        "than the Kinship. Its body is a skeleton it rebuilt so many times that "
        "the bones have turned to stone.\n\n"
        "It pumps from the slow heat of the rock, like every HOLLOW kin, but its "
        "kernel is so vast that even that trickle fills it, given a century. "
        "When it is full, it brims, and a brimming OSSUREX burns a country.\n\n"
        "It is not cruel. It has simply never had anyone to bout with.",
        0 },

    [LORE_ASH_GREEN] = { LCH_HOLLOWING, LSRC_STORY, "THE ASH GROWS GREEN",
        "OSSUREX was answered in the Bone Throne, and a hundred years of surplus "
        "spilled out of it at last, gently, the way a bout spills it: as warm "
        "ground and soft rain.\n\n"
        "The haze over the Ashen March thinned in a single afternoon. The ash "
        "stopped falling. Rain came, and the ash, which had always been rich, "
        "finally had water.\n\n"
        "The hollow kin in the fields are still there; they have bodies now and "
        "no reason to leave. But they are calm, and the March folk say the "
        "CALCIPUP have started burying things in the pumpkin patches for "
        "luck.\n\n"
        "Duskmere kept its lanterns lit anyway. Old promises are good promises.",
        0 },
    [LORE_HOLLOW_DOWNS] = { LCH_PLACES, LSRC_AUDRA, "HOLLOW DOWNS",
        "The chalk downs mark the Accord's quarantine line. Its barrows hold the old kin of the March. HOLLOW kernels borrow bone and ash to make new bodies. The Waychapel keeps a light for travellers.",
        "The Accord holds the March until a warden bears four crests.\fKeep a steady light among the barrows." },
    [LORE_KINSHIP_VOW] = { LCH_HOLLOWING, LSRC_MAUD, "KINSHIP VOWS",
        "At the Waychapel, Sister Maud tends three candles for the lost. A kernel does not cease to matter when its body falls away.",
        "The old vows still hold: care for every kernel, even the ones left behind." },
