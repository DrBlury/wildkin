/* world/grim/trainers.inc -- Wardens: [TR_X] = { "WARDEN X", count, { species... }, { levels... }, prize, "intro", "lose" },. Owner: W-GRIM. */
    /* ASHEN FIELDS */
    [TR_ROOK] = { "WARDEN ROOK", 1, { SP_DREGCROW }, { 35 }, 1300,
                  "The crows came back to the fields before the people did. Care to meet them?",
                  "Scattered like crows off a fence. Well bouted!" },
    [TR_PENN] = { "WARDEN PENN", 1, { SP_PUMPKLING }, { 35 }, 1400,
                  "Nothing grew here for a hundred years. Now pumpkins do. Watch this!",
                  "Harvest's in, and it's yours. Fair enough!" },
    [TR_IVO] = { "WARDEN IVO", 1, { SP_CALCIPUP }, { 36 }, 1500,
                 "My CALCIPUP dug up a whole ribcage yesterday. It wants a bout now.",
                 "Rattled! It'll bury that loss by morning." },
    /* GRAVEWOOD */
    [TR_ODA] = { "WARDEN ODA", 1, { SP_SHROOMLET }, { 35 }, 1600,
                 "Spores and silk. Gravewood keeps everything that falls in it.",
                 "You cut right through the web. Mind the next one." },
    [TR_FENWICK] = { "WARDEN FENWICK", 1, { SP_OSSIHOUND }, { 37 }, 1600,
                     "The dead oaks whisper, and my hound answers. So do I!",
                     "Hush now, hound. We were answered." },
    [TR_MAB] = { "WARDEN MAB", 1, { SP_NOXKIT }, { 36 }, 1800,
                 "Mire's end, warden. One kin between you and DUSKMERE's lanterns.",
                 "The lanterns are yours to follow. Go on." },
    /* LANTERN CRYPT */
    [TR_LUMA] = { "WARDEN LUMA", 1, { SP_WICKLET }, { 37 }, 2000,
                  "You found me by my candle. Can you find MORWEN in the dark?",
                  "My wick's out. Yours burns bright." },
    [TR_TOBIN] = { "WARDEN TOBIN", 1, { SP_RATTLEBONE }, { 37 }, 2000,
                   "Walls in here lie, warden. I don't. Bout!",
                   "Honest defeat. The crypt's walls could learn from me." },
    [TR_SABLE] = { "WARDEN SABLE", 1, { SP_BOGSHAMBLE }, { 38 }, 2100,
                   "Every lamp in this crypt was lit by a warden who lost to MORWEN. Mine too.",
                   "Go and light yours, then." },
    [TR_MORWEN] = { "MORWEN", 6, { SP_CAWDAVER, SP_BOGSHAMBLE, SP_JACKOGRIM, SP_CRYPTCLAW, SP_REAPMANTIS, SP_OSSIGUARD },
                    { 38, 38, 39, 39, 40, 41 }, 4200,
                    "", "The crypt is lit again. Take the LANTERN CREST, warden." },
    /* THE OSSUARY */
    [TR_CORVIN] = { "WARDEN CORVIN", 3, { SP_NOCTAVE, SP_CRYPTCLAW, SP_OSSIHOUND }, { 46, 46, 47 }, 2600,
                    "Six crests, and still you came down here? Then bout like it.",
                    "The Accord chose well." },
    [TR_ELSPETH] = { "WARDEN ELSPETH", 3, { SP_LAMPGHAST, SP_HOPSHI, SP_OSSIGUARD }, { 46, 47, 48 }, 2700,
                     "I tend the ossuary lamps. The bones like the company.",
                     "Mind the lamps on your way down." },
    [TR_GRIMSBY] = { "WARDEN GRIMSBY", 4, { SP_CAWDAVER, SP_BOGSHAMBLE, SP_WENDIGAUNT, SP_REAPMANTIS }, { 48, 48, 49, 49 }, 3000,
                     "The throne is close. Can you hear it breathing? Neither can I. Bones don't.",
                     "Then go. It's waited a hundred years for someone like you." },
    [TR_HESTER] = { "WARDEN HESTER", 3, { SP_GARGOLITH, SP_HOLLOWHELM, SP_OSSIGUARD }, { 49, 49, 50 }, 3200,
                    "Last warden before the throne. Prove the Accord was right about you.",
                    "It was. Go softly, and answer it well." },
    [TR_AUDRA_PATROL] = { "ACCORD PATROL", 1, { SP_CALCIPUP }, { 34 }, 1800, "March patrol. Show your bonds!", "Pass, warden." },
    [TR_DIGGER] = { "BARROW DIGGER", 1, { SP_DIGGET }, { 34 }, 1900, "Keep your shovel ready.", "The old stones stay put." },
    [TR_PILGRIM_A] = { "PILGRIM ADA", 2, { SP_STRAWSPECT, SP_OSSIHOUND }, { 35, 36 }, 1900, "A candle for the lost!", "The flame carries on." },
    [TR_PILGRIM_B] = { "PILGRIM BEA", 2, { SP_JACKOGRIM, SP_CALCIPUP }, { 35, 36 }, 1900, "Walk beside me!", "The flame carries on." },
    [TR_CUTTER] = { "CHALK CUTTER", 1, { SP_DIGGET }, { 35 }, 2100, "Chalk dust in your eyes!", "You saw clearly." },
    [TR_DOWNS_WATCH] = { "DOWNS WATCH", 1, { SP_NOXKIT }, { 36 }, 2100, "A night watch without sleep.", "Watch the dene." },
